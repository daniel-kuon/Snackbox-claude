@code {
    private List<UserDto>? _users;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _emailSuccess;
    private bool _showCreateEditModal;
    private bool _showBulkEmailModal;
    private int? _editingUserId;
    private UserFormModel _userForm = new();
    private EditContext? _userEditContext;
    private string? _modalError;
    private bool _isSaving;
    private string _userSearch = string.Empty;
    private string _userSort = "username";
    private bool _userSortAsc = true;
    private bool _showSpareModal;
    private SpareCardFormModel _spareForm = new();
    private EditContext? _spareEditContext;
    private string? _spareError;
    private bool _isSavingSpare;
    private bool _isSendingEmails;
    private HashSet<int> _selectedUserIds = new();
    private string _userFilter = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _userEditContext = new EditContext(_userForm);
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await UsersApi.GetAllAsync();
            _users = result.ToList();
        }
        catch (ApiException ex)
        {
            _errorMessage = $"Failed to load users: {ex.Message}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load users: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowBulkEmailModal()
    {
        _showBulkEmailModal = true;
        _modalError = null;
        _userFilter = string.Empty;
        _selectedUserIds.Clear();

        // Pre-select all users with balance >= 10
        if (_users != null)
        {
            foreach (var user in _users.Where(u => u.Balance < -10 && !string.IsNullOrEmpty(u.Email)))
            {
                _selectedUserIds.Add(user.Id);
            }
        }
    }

    private void CloseBulkEmailModal()
    {
        _showBulkEmailModal = false;
        _selectedUserIds.Clear();
        _userFilter = string.Empty;
    }

    private List<UserDto> GetFilteredUsersForEmail()
    {
        if (_users == null) return new List<UserDto>();

        var eligible = _users.Where(u => u.Balance < -10 && !string.IsNullOrEmpty(u.Email));

        if (string.IsNullOrWhiteSpace(_userFilter))
            return eligible.ToList();

        return eligible.Where(u => u.Username.Contains(_userFilter, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void ToggleUserSelection(int userId, bool isSelected)
    {
        if (isSelected)
            _selectedUserIds.Add(userId);
        else
            _selectedUserIds.Remove(userId);
    }

    private void SelectAllUsers()
    {
        foreach (var user in GetFilteredUsersForEmail())
        {
            _selectedUserIds.Add(user.Id);
        }
    }

    private void DeselectAllUsers()
    {
        _selectedUserIds.Clear();
    }

    private async Task SendBulkPaymentReminders()
    {
        if (_selectedUserIds.Count == 0) return;

        _isSendingEmails = true;
        _errorMessage = null;
        _emailSuccess = null;

        try
        {
            // Send individual reminders to selected users
            int successCount = 0;
            foreach (var userId in _selectedUserIds)
            {
                try
                {
                    var response = await Http.PostAsync($"api/email/send-payment-reminder/{userId}", null);
                    if (response.IsSuccessStatusCode)
                        successCount++;
                }
                catch
                {
                    // Continue with other users even if one fails
                }
            }

            _emailSuccess = $"Payment reminders sent to {successCount} user(s)";
            _showBulkEmailModal = false;
            _selectedUserIds.Clear();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error sending reminders: {ex.Message}";
        }
        finally
        {
            _isSendingEmails = false;
        }
    }

    private void NavigateToUserDetail(int userId)
    {
        Navigation.NavigateTo($"/admin/users/{userId}");
    }

    private void ShowCreateUser()
    {
        _editingUserId = null;
        _userForm = new UserFormModel { IsActive = true, Role = "User" };
        _userEditContext = new EditContext(_userForm);
        _modalError = null;
        _showCreateEditModal = true;
    }

    private async Task SaveUser()
    {
        _isSaving = true;
        _modalError = null;

        try
        {
            if (_editingUserId == null)
            {
                // Create new user
                var createDto = new CreateUserDto
                {
                    Username = _userForm.Username,
                    Email = _userForm.Email,
                    IsAdmin = _userForm.Role == "Admin",
                    IsActive = _userForm.IsActive,
                    IsBetaTester = _userForm.IsBetaTester,
                    PurchaseBarcode1 = _userForm.PurchaseBarcode1,
                    PurchaseBarcode2 = _userForm.PurchaseBarcode2
                };
                await UsersApi.CreateAsync(createDto);
                CloseModal();
                await LoadUsers();
            }
            else
            {
                // Update existing user
                var updateDto = new UpdateUserDto
                {
                    Username = _userForm.Username,
                    Email = _userForm.Email,
                    IsAdmin = _userForm.Role == "Admin",
                    IsActive = _userForm.IsActive,
                    IsBetaTester = _userForm.IsBetaTester
                };
                await UsersApi.UpdateAsync(_editingUserId.Value, updateDto);
                CloseModal();
                await LoadUsers();
            }
        }
        catch (ApiException ex)
        {
            _modalError = ex.Content ?? "Failed to save user. Please try again.";
        }
        catch (Exception ex)
        {
            _modalError = $"Error: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CloseModal()
    {
        _showCreateEditModal = false;
        _editingUserId = null;
        _userForm = new();
        _userEditContext = null;
        _modalError = null;
    }

    // Search + sort for the user list. Retired/inactive rows keep their styling; only
    // the visible set changes.
    private List<UserDto> VisibleUsers()
    {
        if (_users == null)
            return new List<UserDto>();

        var search = _userSearch?.Trim() ?? string.Empty;
        IEnumerable<UserDto> users = _users;
        if (search.Length > 0)
        {
            users = users.Where(u =>
                u.Username.Contains(search, StringComparison.OrdinalIgnoreCase)
                || (u.Email?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        users = _userSort switch
        {
            "email" => _userSortAsc ? users.OrderBy(u => u.Email) : users.OrderByDescending(u => u.Email),
            "balance" => _userSortAsc ? users.OrderBy(u => u.Balance) : users.OrderByDescending(u => u.Balance),
            _ => _userSortAsc ? users.OrderBy(u => u.Username) : users.OrderByDescending(u => u.Username)
        };

        return users.ToList();
    }

    private void SortUsersBy(string column)
    {
        if (_userSort == column)
            _userSortAsc = !_userSortAsc; // same column again flips direction
        else
        {
            _userSort = column;
            _userSortAsc = true;
        }
    }

    private string SortIndicator(string column) =>
        _userSort != column ? "" : _userSortAsc ? "▲" : "▼";

    private void ShowCreateSpareCard()
    {
        _spareForm = new SpareCardFormModel();
        _spareEditContext = new EditContext(_spareForm);
        _spareError = null;
        _showSpareModal = true;
    }

    private async Task SaveSpareCard()
    {
        _isSavingSpare = true;
        _spareError = null;
        try
        {
            // Reuse the standard create endpoint: an inactive placeholder user known by number,
            // with two purchase barcodes. The person claims it via the scanner setup wizard.
            await UsersApi.CreateAsync(new CreateUserDto
            {
                Username = $"Spare card {_spareForm.CardNumber.Trim()}",
                Email = null,
                IsAdmin = false,
                IsActive = false,
                PurchaseBarcode1 = _spareForm.PurchaseBarcode1?.Trim(),
                PurchaseBarcode2 = _spareForm.PurchaseBarcode2?.Trim()
            });
            CloseSpareModal();
            await LoadUsers();
        }
        catch (ApiException ex)
        {
            _spareError = ex.Content ?? "Failed to create spare card. Please try again.";
        }
        catch (Exception ex)
        {
            _spareError = $"Error: {ex.Message}";
        }
        finally
        {
            _isSavingSpare = false;
        }
    }

    private void CloseSpareModal()
    {
        _showSpareModal = false;
        _spareForm = new();
        _spareEditContext = null;
        _spareError = null;
    }

    private class SpareCardFormModel : IValidatableObject
    {
        [Required]
        public string CardNumber { get; set; } = string.Empty;

        [Required]
        public string PurchaseBarcode1 { get; set; } = string.Empty;

        [Required]
        public string PurchaseBarcode2 { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.IsNullOrWhiteSpace(PurchaseBarcode1) &&
                PurchaseBarcode1.Equals(PurchaseBarcode2, StringComparison.OrdinalIgnoreCase))
            {
                yield return new ValidationResult(
                    "The two barcodes must be different",
                    new[] { nameof(PurchaseBarcode2) });
            }
        }
    }

    private class UserFormModel : IValidatableObject
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [EmailAddress]
        public string? Email { get; set; }

        [Required]
        public string Role { get; set; } = "User";

        public bool IsActive { get; set; } = true;

        public bool IsBetaTester { get; set; }

        public string? PurchaseBarcode1 { get; set; }

        public string? PurchaseBarcode2 { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.IsNullOrWhiteSpace(PurchaseBarcode1) &&
                !string.IsNullOrWhiteSpace(PurchaseBarcode2) &&
                PurchaseBarcode1.Equals(PurchaseBarcode2, StringComparison.OrdinalIgnoreCase))
            {
                yield return new ValidationResult(
                    "Purchase barcodes must be different",
                    new[] { nameof(PurchaseBarcode2) }
                );
            }
        }
    }

