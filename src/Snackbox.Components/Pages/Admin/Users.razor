@page "/admin/users"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Snackbox.ApiClient
@using Snackbox.Api.Dtos
@using Refit
@inject IUsersApi UsersApi
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>User Management - Snackbox Admin</PageTitle>

<div class="container-fluid">
    <div class="page-header">
        <h2>User Management</h2>
        <div class="button-group">
            <button class="btn btn-warning" @onclick="ShowBulkEmailModal" disabled="@_isSendingEmails">
                @if (_isSendingEmails)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                <span class="icon">✉</span> Send Payment Reminders (>€10)
            </button>
            <button class="btn btn-outline-primary" @onclick="ShowCreateSpareCard">
                <span class="icon">🎫</span> Add Spare Card
            </button>
            <button class="btn btn-primary" @onclick="ShowCreateUser">
                <span class="icon">+</span> Add User
            </button>
        </div>
    </div>

    @if (_emailSuccess != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @_emailSuccess
            <button type="button" class="btn-close" @onclick='() => _emailSuccess = null'></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="loading-container">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading users...</p>
        </div>
    }
    else if (_errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }
    else if (_users != null && _users.Any())
    {
        <div class="list-toolbar">
            <input class="form-control list-search" placeholder="Search name or email…"
                   @bind="_userSearch" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_userSearch))
            {
                <button class="btn btn-link btn-sm" @onclick="() => _userSearch = string.Empty">Clear</button>
            }
            <span class="list-count">@VisibleUsers().Count of @_users.Count</span>
        </div>

        <div class="table-container">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th class="sortable" @onclick='() => SortUsersBy("username")'>Username @SortIndicator("username")</th>
                        <th class="sortable" @onclick='() => SortUsersBy("email")'>Email @SortIndicator("email")</th>
                        <th class="sortable" @onclick='() => SortUsersBy("balance")'>Balance @SortIndicator("balance")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in VisibleUsers())
                    {
                        var rowClass = !user.IsActive && user.HasPurchases ? "table-warning" : (!user.IsActive ? "table-light text-muted" : "");
                        <tr @onclick="() => NavigateToUserDetail(user.Id)" style="cursor: pointer;" class="@rowClass">
                            <td>
                                @user.Username
                                @if (user.IsBetaTester)
                                {
                                    <span class="badge bg-info ms-1" title="Sees features released to beta testers">Beta</span>
                                }
                                @if (user.IsRetired)
                                {
                                    <span class="badge bg-secondary ms-1">Retired</span>
                                }
                                else if (!user.IsActive)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Inactive</span>
                                }
                            </td>
                            <td>@user.Email</td>
                            <td class="@(user.Balance < 0 ? "text-danger" : "text-success")">
                                €@user.Balance.ToString("F2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No users found.</p>
            <button class="btn btn-primary" @onclick="ShowCreateUser">Add Your First User</button>
        </div>
    }
</div>

@if (_showCreateEditModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3>@(_editingUserId == null ? "Create User" : "Edit User")</h3>
                <button class="btn-close" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (_modalError != null)
                {
                    <div class="alert alert-danger">@_modalError</div>
                }
                <EditForm EditContext="@_userEditContext" OnValidSubmit="@SaveUser">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label>Username</label>
                        <InputText @bind-Value="_userForm.Username" class="form-control" />
                        <ValidationMessage For="@(() => _userForm.Username)" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <InputText @bind-Value="_userForm.Email" class="form-control" type="email" />
                        <ValidationMessage For="@(() => _userForm.Email)" />
                    </div>

                    <div class="form-group">
                        <label>Role</label>
                        <InputSelect @bind-Value="_userForm.Role" class="form-control">
                            <option value="User">User</option>
                            <option value="Admin">Admin</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => _userForm.Role)" />
                    </div>

                    <div class="form-check">
                        <InputCheckbox @bind-Value="_userForm.IsActive" class="form-check-input" id="isActiveCheck" />
                        <label class="form-check-label" for="isActiveCheck">
                            Active
                        </label>
                    </div>

                    <div class="form-check">
                        <InputCheckbox @bind-Value="_userForm.IsBetaTester" class="form-check-input" id="isBetaCheck" />
                        <label class="form-check-label" for="isBetaCheck">
                            Beta tester <small class="text-muted">— also sees features set to "Beta testers only"</small>
                        </label>
                    </div>

                    <div class="form-group">
                        <label>Purchase Barcode 1 (€0.50)</label>
                        <InputText @bind-Value="_userForm.PurchaseBarcode1" class="form-control" placeholder="Optional" />
                        <ValidationMessage For="@(() => _userForm.PurchaseBarcode1)" />
                    </div>

                    <div class="form-group">
                        <label>Purchase Barcode 2 (€0.30)</label>
                        <InputText @bind-Value="_userForm.PurchaseBarcode2" class="form-control" placeholder="Optional" />
                        <ValidationMessage For="@(() => _userForm.PurchaseBarcode2)" />
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            Save
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (_showSpareModal)
{
    <div class="modal-backdrop" @onclick="CloseSpareModal"></div>
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Add Spare Card</h3>
                <button class="btn-close" @onclick="CloseSpareModal">&times;</button>
            </div>
            <div class="modal-body">
                <p class="text-muted">
                    A spare card is known only by its number and its two purchase barcodes (€0.50 and €0.30).
                    Purchases work immediately; the person claims it by entering their name on the scanner the first time they use it.
                </p>
                @if (_spareError != null)
                {
                    <div class="alert alert-danger">@_spareError</div>
                }
                <EditForm EditContext="@_spareEditContext" OnValidSubmit="@SaveSpareCard">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label>Card number</label>
                        <InputText @bind-Value="_spareForm.CardNumber" class="form-control" placeholder="e.g. 1" />
                        <ValidationMessage For="@(() => _spareForm.CardNumber)" />
                    </div>

                    <div class="form-group">
                        <label>Purchase Barcode 1 (€0.50)</label>
                        <InputText @bind-Value="_spareForm.PurchaseBarcode1" class="form-control" />
                        <ValidationMessage For="@(() => _spareForm.PurchaseBarcode1)" />
                    </div>

                    <div class="form-group">
                        <label>Purchase Barcode 2 (€0.30)</label>
                        <InputText @bind-Value="_spareForm.PurchaseBarcode2" class="form-control" />
                        <ValidationMessage For="@(() => _spareForm.PurchaseBarcode2)" />
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseSpareModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@_isSavingSpare">
                            @if (_isSavingSpare)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            Create Spare Card
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (_showBulkEmailModal)
{
    <div class="modal-backdrop" @onclick="CloseBulkEmailModal"></div>
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Send Payment Reminders</h3>
                <button class="btn-close" @onclick="CloseBulkEmailModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (_modalError != null)
                {
                    <div class="alert alert-danger">@_modalError</div>
                }

                <div class="form-group">
                    <label>Filter users</label>
                    <input type="text" @bind="_userFilter" @bind:event="oninput" class="form-control" placeholder="Search by name..." />
                </div>

                <div class="mb-3">
                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="SelectAllUsers">Select All</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DeselectAllUsers">Deselect All</button>
                    <span class="ms-3 text-muted">@_selectedUserIds.Count selected</span>
                </div>

                <div class="user-selection-list">
                    @foreach (var user in GetFilteredUsersForEmail())
                    {
                        <div class="user-selection-item">
                            <input type="checkbox"
                                   id="user-@user.Id"
                                   checked="@_selectedUserIds.Contains(user.Id)"
                                   @onchange="@(e => ToggleUserSelection(user.Id, (bool)e.Value!))" />
                            <label for="user-@user.Id">
                                <span class="user-name">@user.Username</span>
                                <span class="user-balance text-danger">€@Math.Abs(user.Balance).ToString("F2")</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseBulkEmailModal">Cancel</button>
                <button type="button" class="btn btn-warning" @onclick="SendBulkPaymentReminders" disabled="@(_isSendingEmails || _selectedUserIds.Count == 0)">
                    @if (_isSendingEmails)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Send to @_selectedUserIds.Count user(s)
                </button>
            </div>
        </div>
    </div>
}

