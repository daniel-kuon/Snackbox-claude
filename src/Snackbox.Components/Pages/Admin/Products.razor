@page "/admin/products"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Snackbox.Api.Dtos
@using Snackbox.ApiClient
@using Refit
@using Snackbox.Components.Components.Shared
@inject IProductsApi ProductsApi
@inject IShelvingActionsApi ShelvingActionsApi
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Product Management - Snackbox Admin</PageTitle>

<div class="container-fluid">
    <div class="page-header">
        <h2>Product Management</h2>
        <div class="header-buttons">
            <button class="btn btn-secondary" @onclick="ShowBarcodeLookup">
                <i class="bi bi-search icon" aria-hidden="true"></i> Lookup Barcode
            </button>
            <button class="btn btn-primary" @onclick="ShowCreateProduct">
                <span class="icon">+</span> Add Product
            </button>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="search-bar">
        <input type="text" class="form-control search-input" placeholder="Search products..."
               @bind="_searchTerm" @bind:event="oninput" @onkeyup="FilterProducts" />
        <select class="form-control sort-select" @bind="_sortBy" @bind:after="SortProducts">
            <option value="name">Sort by Name</option>
            <option value="created">Sort by Created Date</option>
            <option value="average">Sort by Most Sold (Avg/Week)</option>
        </select>
        @if (!_batchMode)
        {
            <button class="btn btn-outline-primary" @onclick="StartBatchMode">
                <i class="bi bi-upc-scan icon" aria-hidden="true"></i> Start Batch
            </button>
        }
    </div>

    @if (_batchMode)
    {
        <div class="batch-mode-section">
            <div class="batch-mode-header">
                <div>
                    <h3>Batch Scan Mode</h3>
                    <p class="text-muted">Keep scanning - the same product again counts up its row. Unknown codes are looked up online and added to a matching product, or become a new one.</p>
                </div>
                <button class="btn btn-secondary" @onclick="ExitBatchMode">
                    <i class="bi bi-x-lg" aria-hidden="true"></i> Exit Batch Mode
                </button>
            </div>

            <div class="batch-controls">
                <div class="control-group">
                    <label>Action Type</label>
                    <select class="form-control" @bind="_batchActionType">
                        <option value="AddedToStorage">Add to Storage</option>
                        <option value="AddedToShelf">Add Directly to Shelf</option>
                        <option value="MovedToShelf">Move from Storage to Shelf</option>
                    </select>
                </div>
                <div class="control-group flex-grow">
                    <label>Scan Barcode</label>
                    <BarcodeInput @bind-Value="_batchBarcode"
                                  OnScan="@OnBatchScan"
                                  Placeholder="Scan or enter barcode..." />
                </div>
            </div>

            @if (_batchResolving > 0)
            {
                <div class="text-muted mb-2"><span class="spinner-border spinner-border-sm"></span> Looking up @_batchResolving code(s)...</div>
            }

            @if (_batchError != null)
            {
                <div class="alert alert-danger">@_batchError</div>
            }
            @if (_batchSuccess != null)
            {
                <div class="alert alert-success">@_batchSuccess</div>
            }

            @if (_batchScannedItems.Any())
            {
                <div class="batch-items">
                    <div class="batch-header">
                        <h4>Scanned Items (@_batchScannedItems.Sum(i => i.Quantity))</h4>
                        <div class="batch-actions">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearBatchItems">Clear All</button>
                            <button class="btn btn-success btn-sm" @onclick="ProcessBatchItems" disabled="@(_isBatchProcessing || _batchScannedItems.Any(i => i.ProductId == 0))">
                                @if (_isBatchProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                Finish Batch (@_batchScannedItems.Count)
                            </button>
                        </div>
                    </div>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Barcode</th>
                                <th>Quantity</th>
                                <th>Best Before</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _batchScannedItems)
                            {
                                <tr @key="item" class="@(item.ProductId == 0 ? "unknown-row" : "")">
                                    <td>
                                        @if (item.ProductId == 0)
                                        {
                                            <div class="small text-danger mb-1">Not found online - name the new product:</div>
                                            <div class="d-flex gap-1">
                                                <input class="form-control form-control-sm" @bind="item.NewName" @bind:event="oninput" placeholder="Product name" />
                                                <button class="btn btn-sm btn-primary" @onclick="() => CreateUnknownProduct(item)"
                                                        disabled="@string.IsNullOrWhiteSpace(item.NewName)">Create</button>
                                            </div>
                                        }
                                        else
                                        {
                                            @item.ProductName
                                            @if (item.Status == BarcodeResolveStatus.Created)
                                            {
                                                <span class="badge badge-info">new product</span>
                                            }
                                            else if (item.Status == BarcodeResolveStatus.AssignedToExisting)
                                            {
                                                <div class="small text-muted">
                                                    Code added to this product (online: "@item.OnlineTitle").
                                                    <button class="btn btn-link btn-sm p-0" @onclick="() => MakeSeparateProduct(item)">Wrong? Make it a new product</button>
                                                </div>
                                            }
                                        }
                                    </td>
                                    <td><code>@string.Join(", ", item.Barcodes)</code></td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" style="width: 80px;"
                                               @bind="item.Quantity" min="1" />
                                    </td>
                                    <td>
                                        @if (item.ActionType == "MovedToShelf" && item.AvailableDates.Any())
                                        {
                                            <select class="form-control form-control-sm" @bind="item.SelectedDate">
                                                @foreach (var date in item.AvailableDates)
                                                {
                                                    <option value="@date.ToString("yyyy-MM-dd")">@date.ToString("yyyy-MM-dd")</option>
                                                }
                                            </select>
                                        }
                                        else if (item.ActionType == "MovedToShelf")
                                        {
                                            <span class="text-muted">No stock</span>
                                        }
                                        else
                                        {
                                            <input type="date" class="form-control form-control-sm" value="@item.BestBeforeDate"
                                                   @onchange="@(e => item.BestBeforeDate = e.Value?.ToString() ?? "")" />
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveBatchItem(item)">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @if (_isLoading)
    {
        <div class="loading-container">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading products...</p>
        </div>
    }
    else if (_errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }
    else if (_filteredProducts != null && _filteredProducts.Any())
    {
        <div class="table-container">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Avg/Week</th>
                        <th>Best before in Stock</th>
                        <th>Best before on Shelf</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in _filteredProducts)
                    {
                        var hasExpiredInStock = product.BestBeforeInStock.HasValue && product.BestBeforeInStock.Value < DateTime.UtcNow;
                        var hasExpiringInStock = product.BestBeforeInStock.HasValue && product.BestBeforeInStock.Value >= DateTime.UtcNow && product.BestBeforeInStock.Value < DateTime.UtcNow.AddDays(30);
                        var hasExpiredOnShelf = product.BestBeforeOnShelf.HasValue && product.BestBeforeOnShelf.Value < DateTime.UtcNow;
                        var hasExpiringOnShelf = product.BestBeforeOnShelf.HasValue && product.BestBeforeOnShelf.Value >= DateTime.UtcNow && product.BestBeforeOnShelf.Value < DateTime.UtcNow.AddDays(30);
                        var rowClass = (hasExpiredInStock || hasExpiredOnShelf) ? "expired-row" : (hasExpiringInStock || hasExpiringOnShelf) ? "expiring-row" : "";

                        <tr @onclick="() => NavigateToProductDetail(product.Id)" style="cursor: pointer;" class="@rowClass">
                            <td>@product.Name @(product.HasImage ? "🖼" : "")</td>
                            <td>@(product.Price?.ToString("0.00 €") ?? "-")</td>
                            <td>@product.AverageProductsShelvedPerWeek.ToString("F1")</td>
                            <td class="@(hasExpiredInStock ? "expired-cell" : hasExpiringInStock ? "expiring-cell" : "")">
                                @(product.BestBeforeInStock?.ToString("yyyy-MM-dd") ?? "-")
                                @if (hasExpiredInStock)
                                {
                                    <span class="badge badge-danger">Expired</span>
                                }
                                else if (hasExpiringInStock)
                                {
                                    <span class="badge badge-warning">Soon</span>
                                }
                            </td>
                            <td class="@(hasExpiredOnShelf ? "expired-cell" : hasExpiringOnShelf ? "expiring-cell" : "")">
                                @(product.BestBeforeOnShelf?.ToString("yyyy-MM-dd") ?? "-")
                                @if (hasExpiredOnShelf)
                                {
                                    <span class="badge badge-danger">Expired</span>
                                }
                                else if (hasExpiringOnShelf)
                                {
                                    <span class="badge badge-warning">Soon</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary" @onclick:stopPropagation="true" @onclick="() => ShowEditProduct(product)">
                                    Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(product)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No products found.</p>
            <button class="btn btn-primary" @onclick="ShowCreateProduct">Add Your First Product</button>
        </div>
    }
</div>

@if (_showCreateEditModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3>@(_editingProduct == null ? "Create Product" : "Edit Product")</h3>
                <button class="btn-close" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (_modalError != null)
                {
                    <div class="alert alert-danger">@_modalError</div>
                }
                <EditForm Model="@_productForm" OnValidSubmit="@SaveProduct">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label>Product Name</label>
                        <InputText @bind-Value="_productForm.Name" class="form-control" />
                        <ValidationMessage For="@(() => _productForm.Name)" />
                    </div>

                    <div class="form-group">
                        <label>Price per item (EUR, for the tablet)</label>
                        <InputNumber @bind-Value="_productForm.Price" class="form-control" step="0.01" min="0" />
                        <small class="text-muted">Leave empty to keep the product off the tablet.</small>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            Save
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (_showDeleteModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Confirm Delete</h3>
                <button class="btn-close" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (_modalError != null)
                {
                    <div class="alert alert-danger">@_modalError</div>
                }
                <p>Are you sure you want to delete the product "<strong>@_productToDelete?.Name</strong>"?</p>
                <p class="text-muted">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteProduct" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Delete
                </button>
            </div>
        </div>
    </div>
}

<BarcodeLookupModal IsVisible="@_showBarcodeLookupModal"
                    OnClose="@CloseBarcodeLookup"
                    OnProductCreated="@OnProductCreatedFromLookup" />

