@code {
    private List<ProductDto>? _products;
    private List<ProductDto>? _filteredProducts;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _searchTerm = "";
    private string _sortBy = "name";

    private bool _showCreateEditModal;
    private bool _showDeleteModal;
    private bool _showBarcodeLookupModal;
    private ProductDto? _editingProduct;
    private ProductDto? _productToDelete;
    private ProductFormModel _productForm = new();
    private string? _modalError;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await ProductsApi.GetAllAsync();
            _products = result.ToList();
            FilterProducts();
        }
        catch (ApiException ex)
        {
            _errorMessage = $"Failed to load products: {ex.Message}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load products: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterProducts()
    {
        if (_products == null) return;

        _filteredProducts = _products
            .Where(p => string.IsNullOrEmpty(_searchTerm) ||
                        p.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
            .ToList();

        SortProducts();
    }

    private void SortProducts()
    {
        if (_filteredProducts == null) return;

        _filteredProducts = _sortBy switch
        {
            "name" => _filteredProducts.OrderBy(p => p.Name).ToList(),
            "created" => _filteredProducts.OrderByDescending(p => p.CreatedAt).ToList(),
            "average" => _filteredProducts.OrderByDescending(p => p.AverageProductsShelvedPerWeek).ToList(),
            _ => _filteredProducts
        };
    }

    private void NavigateToProductDetail(int productId)
    {
        Navigation.NavigateTo($"/admin/products/{productId}");
    }

    private void ShowCreateProduct()
    {
        _editingProduct = null;
        _productForm = new ProductFormModel();
        _modalError = null;
        _showCreateEditModal = true;
    }

    private void ShowEditProduct(ProductDto product)
    {
        _editingProduct = product;
        _productForm = new ProductFormModel
        {
            Name = product.Name,
            Price = product.Price,
        };
        _modalError = null;
        _showCreateEditModal = true;
    }

    private void ConfirmDelete(ProductDto product)
    {
        _productToDelete = product;
        _modalError = null;
        _showDeleteModal = true;
    }

    private async Task SaveProduct()
    {
        _isSaving = true;
        _modalError = null;

        try
        {
            if (_editingProduct == null)
            {
                var createDto = new CreateProductDto
                {
                    Name = _productForm.Name,
                    Price = _productForm.Price,
                };
                await ProductsApi.CreateAsync(createDto);
            }
            else
            {
                var updateDto = new UpdateProductDto
                {
                    Name = _productForm.Name,
                    Price = _productForm.Price,
                    ShelfSlot = _editingProduct.ShelfSlot, // set on the product page
                };
                await ProductsApi.UpdateAsync(_editingProduct.Id, updateDto);
            }

            CloseModal();
            await LoadProducts();
        }
        catch (ApiException ex)
        {
            _modalError = ex.Content ?? "Failed to save product. Please try again.";
        }
        catch (Exception ex)
        {
            _modalError = $"Error: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteProduct()
    {
        if (_productToDelete == null) return;

        _isSaving = true;
        _modalError = null;

        try
        {
            await ProductsApi.DeleteAsync(_productToDelete.Id);
            CloseModal();
            await LoadProducts();
        }
        catch (ApiException ex)
        {
            _modalError = ex.Content ?? "Failed to delete product. Please try again.";
        }
        catch (Exception ex)
        {
            _modalError = $"Error: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CloseModal()
    {
        _showCreateEditModal = false;
        _showDeleteModal = false;
        _editingProduct = null;
        _productToDelete = null;
        _productForm = new();
        _modalError = null;
    }

    // Batch mode state
    private bool _batchMode;
    private string _batchActionType = "AddedToStorage";
    private string _batchBarcode = string.Empty;
    private List<BatchScannedItem> _batchScannedItems = new();
    private bool _isBatchProcessing;
    private int _batchResolving;
    private string? _batchError;
    private string? _batchSuccess;

    private void ShowBarcodeLookup()
    {
        _showBarcodeLookupModal = true;
    }

    private void CloseBarcodeLookup()
    {
        _showBarcodeLookupModal = false;
    }

    private async Task OnProductCreatedFromLookup()
    {
        await LoadProducts();
    }

    private void StartBatchMode()
    {
        _batchMode = true;
        _batchActionType = "AddedToStorage";
        ClearBatchItems();
    }

    private void ExitBatchMode()
    {
        _batchMode = false;
        ClearBatchItems();
    }

    // Scans can come faster than the online lookup answers - each one is handled on its own
    private async Task OnBatchScan(string barcode)
    {
        if (string.IsNullOrWhiteSpace(barcode)) return;
        _batchError = null;
        _batchSuccess = null;

        // A code already in the list counts up its row without asking the server again
        var existing = _batchScannedItems.FirstOrDefault(i => i.Barcodes.Contains(barcode) && i.ActionType == _batchActionType);
        if (existing != null)
        {
            existing.Quantity += existing.BarcodeQuantities[barcode];
            MoveToTop(existing);
            return;
        }

        _batchResolving++;
        try
        {
            var result = await ProductsApi.ResolveBarcodeAsync(new BarcodeResolveRequest { Barcode = barcode });
            await AddResolved(barcode, result);
        }
        catch (Exception ex)
        {
            _batchError = $"Error looking up {barcode}: {ex.Message}";
        }
        finally
        {
            _batchResolving--;
        }
    }

    private async Task AddResolved(string barcode, BarcodeResolveResultDto result)
    {
        if (result.Product == null)
        {
            // Unknown here and online: a row that asks for a name, scanning goes on meanwhile
            _batchScannedItems.Insert(0, new BatchScannedItem
            {
                Barcodes = { barcode },
                BarcodeQuantities = { [barcode] = 1 },
                Quantity = 1,
                Status = BarcodeResolveStatus.NotFound,
                ActionType = _batchActionType,
                BestBeforeDate = DefaultBestBefore()
            });
            return;
        }

        var row = _batchScannedItems.FirstOrDefault(i => i.ProductId == result.Product.Id && i.ActionType == _batchActionType);
        if (row != null)
        {
            row.Barcodes.Add(barcode);
            row.BarcodeQuantities[barcode] = result.BarcodeQuantity;
            row.Quantity += result.BarcodeQuantity;
            MoveToTop(row);
            return;
        }

        row = new BatchScannedItem
        {
            ProductId = result.Product.Id,
            ProductName = result.Product.Name,
            Barcodes = { barcode },
            BarcodeQuantities = { [barcode] = result.BarcodeQuantity },
            Quantity = result.BarcodeQuantity,
            Status = result.Status,
            OnlineTitle = result.OnlineTitle,
            ActionType = _batchActionType,
            BestBeforeDate = DefaultBestBefore()
        };

        // For MovedToShelf, populate available dates with storage stock
        if (_batchActionType == "MovedToShelf")
        {
            var stock = await ProductsApi.GetProductStockAsync(result.Product.Id);
            row.AvailableDates = stock.Batches
                .Where(b => b.QuantityInStorage > 0)
                .Select(b => b.BestBeforeDate)
                .OrderBy(d => d)
                .ToList();
            if (row.AvailableDates.Any()) row.SelectedDate = row.AvailableDates[0].ToString("yyyy-MM-dd");
        }

        _batchScannedItems.Insert(0, row);
    }

    // Only set a default date for AddedToStorage and AddedToShelf
    private string DefaultBestBefore() =>
        _batchActionType == "MovedToShelf" ? "" : DateTime.Today.AddDays(30).ToString("yyyy-MM-dd");

    private void MoveToTop(BatchScannedItem item)
    {
        _batchScannedItems.Remove(item);
        _batchScannedItems.Insert(0, item);
    }

    private async Task CreateUnknownProduct(BatchScannedItem item)
    {
        var barcode = item.Barcodes[0];
        try
        {
            var result = await ProductsApi.ResolveBarcodeAsync(new BarcodeResolveRequest { Barcode = barcode, Name = item.NewName });
            var quantity = item.Quantity;
            _batchScannedItems.Remove(item);
            await AddResolved(barcode, result);
            _batchScannedItems.First(i => i.Barcodes.Contains(barcode)).Quantity = quantity;
        }
        catch (Exception ex)
        {
            _batchError = $"Could not create the product: {ex.Message}";
        }
    }

    // The name match was wrong: take the code off that product and give it a product of its own
    private async Task MakeSeparateProduct(BatchScannedItem item)
    {
        try
        {
            var product = await ProductsApi.GetByIdAsync(item.ProductId);
            foreach (var code in item.Barcodes)
            {
                var assigned = product.Barcodes.First(b => b.Barcode == code);
                await ProductsApi.DeleteBarcodeAsync(item.ProductId, assigned.Id);
            }

            var quantity = item.Quantity;
            _batchScannedItems.Remove(item);
            foreach (var code in item.Barcodes)
            {
                var result = await ProductsApi.ResolveBarcodeAsync(new BarcodeResolveRequest { Barcode = code, ForceNewProduct = true });
                await AddResolved(code, result);
            }
            _batchScannedItems.First(i => i.Barcodes.Contains(item.Barcodes[0])).Quantity = quantity;
        }
        catch (Exception ex)
        {
            _batchError = $"Could not split the product: {ex.Message}";
        }
    }

    private void RemoveBatchItem(BatchScannedItem item)
    {
        _batchScannedItems.Remove(item);
    }

    private void ClearBatchItems()
    {
        _batchScannedItems.Clear();
        _batchError = null;
        _batchSuccess = null;
    }

    private async Task ProcessBatchItems()
    {
        if (!_batchScannedItems.Any()) return;

        _isBatchProcessing = true;
        _batchError = null;
        _batchSuccess = null;

        try
        {
            var request = new BatchShelvingRequest();

            foreach (var item in _batchScannedItems)
            {
                var bestBeforeDate = item.ActionType == "MovedToShelf" ? item.SelectedDate ?? item.BestBeforeDate : item.BestBeforeDate;
                if (!DateTime.TryParse(bestBeforeDate, out var parsedDate))
                {
                    _batchError = $"Invalid best before date for '{item.ProductName}': {bestBeforeDate}";
                    return;
                }

                request.Actions.Add(new CreateShelvingActionDto
                {
                    ProductId = item.ProductId,
                    BestBeforeDate = DateTime.SpecifyKind(parsedDate, DateTimeKind.Utc),
                    Quantity = item.Quantity,
                    Type = Enum.Parse<ShelvingActionType>(item.ActionType)
                });
            }

            var response = await Http.PostAsJsonAsync("api/shelvingactions/batch", request);
            var result = await response.Content.ReadFromJsonAsync<BatchShelvingResponse>();

            if (result?.Errors.Any() == true)
            {
                // Keep only the rows that failed, so a retry does not book the rest twice
                var booked = result.Results.Select(r => r.ProductId).ToHashSet();
                _batchScannedItems.RemoveAll(i => booked.Contains(i.ProductId));
                _batchError = string.Join(", ", result.Errors);
                if (result.Results.Any()) _batchSuccess = $"Successfully processed {result.Results.Count} items.";
            }
            else if (response.IsSuccessStatusCode)
            {
                _batchSuccess = $"Successfully processed {_batchScannedItems.Count} items.";
                _batchScannedItems.Clear();
            }
            else
            {
                _batchError = "Failed to process batch items.";
            }

            await LoadProducts(); // Refresh product list
        }
        catch (Exception ex)
        {
            _batchError = $"Error processing batch: {ex.Message}";
        }
        finally
        {
            _isBatchProcessing = false;
        }
    }

    private class BatchScannedItem
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public List<string> Barcodes { get; } = new();
        public Dictionary<string, int> BarcodeQuantities { get; } = new();
        public int Quantity { get; set; }
        public BarcodeResolveStatus Status { get; set; }
        public string? OnlineTitle { get; set; }
        public string? NewName { get; set; }
        public string ActionType { get; set; } = string.Empty;
        public string BestBeforeDate { get; set; } = string.Empty;
        public string? SelectedDate { get; set; }
        public List<DateTime> AvailableDates { get; set; } = new();
    }

    private class ProductFormModel
    {
        [Required(ErrorMessage = "Product name is required")]
        public string Name { get; set; } = string.Empty;

        [Range(0, 100, ErrorMessage = "Price must be between 0 and 100")]
        public decimal? Price { get; set; }
    }
}


