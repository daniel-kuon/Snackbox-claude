@page "/admin/paypal"
@inherits AdminPageBase
@using Snackbox.Api.Dtos
@using Snackbox.ApiClient
@using Refit
@inject IPayPalApi PayPalApi
@inject IUsersApi UsersApi
@implements IDisposable

<PageTitle>PayPal - Snackbox Admin</PageTitle>

<div class="container-fluid">
    <div class="page-header">
        <h2>PayPal payments</h2>
        <p class="text-muted mb-0">
            Payments received on the admin's PayPal account with "Snackbox" in the note, fetched every
            30 minutes (PayPal lists them up to 3 hours late). Assign a payer to a user once: this payment
            and every later one from them is booked as a PayPal payment by itself.
        </p>
    </div>

    <div class="settings-section">
        <div class="settings-section-header"><h4>Where payments come from</h4></div>
        <p class="text-muted small mb-2">
            A private PayPal account gets no API access, but PayPal mails every payment
            ("Du hast eine Zahlung erhalten"). Snackbox reads those mails from the Outlook.com / Microsoft 365
            mailbox they arrive in - read-only, only PayPal's own mails in the inbox that the mail server confirmed as genuine.
            The client id can be the one of the OneDrive backup's app registration (see docs/PAYPAL.md).
        </p>
        @if (_mailbox == null)
        {
            <p>Loading...</p>
        }
        else if (_signIn != null)
        {
            <div class="alert alert-info mb-0">
                Open <a href="@_signIn.VerificationUri" target="_blank" rel="noopener">@_signIn.VerificationUri</a>
                on any device and enter the code <strong>@_signIn.UserCode</strong>, then sign in to the mailbox PayPal's mails go to.
            </div>
        }
        else if (_mailbox.Connected)
        {
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span>Mailbox: <strong>@_mailbox.Account</strong></span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DisconnectMailboxAsync" disabled="@_busy">Disconnect</button>
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label class="form-label">Client id (app registration)</label>
                    <input class="form-control" style="min-width: 22rem" @bind="_clientId" placeholder="00000000-0000-0000-0000-000000000000" />
                </div>
                <button class="btn btn-primary" @onclick="ConnectMailboxAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_clientId))">Connect mailbox</button>
            </div>
            <p class="text-muted small mt-2 mb-0">With a PayPal business account the PayPal API works instead: client id and secret in Admin → Settings.</p>
        }
    </div>

    <div class="settings-section">
        <div class="d-flex flex-wrap align-items-center gap-3">
            @if (_status == null)
            {
                <span>Loading...</span>
            }
            else if (!_status.Configured)
            {
                <span class="text-warning">Not set up yet - connect the mailbox above and choose whose PayPal account it is in <a href="admin/settings">Admin → Settings → PayPal payments</a>.</span>
            }
            else
            {
                <span>
                    Last fetched: @(_status.LastSyncAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "not yet")
                    @if (_status.LastSyncAt != null)
                    {
                        <span class="text-muted"> - @_status.LastAdded new, @_status.LastBooked booked</span>
                    }
                </span>
            }
            <button class="btn btn-primary" @onclick="SyncAsync" disabled="@_busy">Fetch now</button>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="showAll" @bind="_showAll" />
                <label class="form-check-label" for="showAll">Show booked and dismissed ones</label>
            </div>
        </div>
        @if (_status?.LastError is { } lastError)
        {
            <div class="alert alert-danger mt-3 mb-0">@lastError</div>
        }
        @if (_error != null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_error</div>
        }
    </div>

    <div class="settings-section">
        @if (_transactions == null)
        {
            <p>Loading...</p>
        }
        else if (!Shown.Any())
        {
            <p class="text-muted mb-0">@(_showAll ? "No Snackbox payments received yet." : "Nothing to assign - every Snackbox payment is booked.")</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr><th>Received</th><th>From</th><th>Note</th><th class="text-end">Amount</th><th>User</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Shown)
                        {
                            <tr class="@(t.Dismissed ? "text-muted" : "")">
                                <td>@t.ReceivedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @(t.PayerName ?? "?")
                                    @if (t.PayerEmail != null)
                                    {
                                        <div class="small text-muted">@t.PayerEmail</div>
                                    }
                                </td>
                                <td class="small">
                                    @t.Note
                                    @if (t.ReversedAt is { } reversedAt)
                                    {
                                        <div class="text-danger fw-bold">⚠ Taken back by PayPal on @reversedAt.ToLocalTime().ToString("dd.MM.yyyy")@(t.PaymentId != null ? " - the booked payment needs correcting" : "")</div>
                                    }
                                </td>
                                <td class="text-end">@t.Amount.ToString("0.00") @t.Currency</td>
                                @if (t.PaymentId != null)
                                {
                                    <td>✓ @t.BookedUsername</td>
                                    <td>
                                        @if (t.ReversedAt != null)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => DismissAsync(t, true)" disabled="@_busy" title="Corrected - hide it">Done</button>
                                        }
                                    </td>
                                }
                                else if (t.Dismissed)
                                {
                                    <td>dismissed</td>
                                    <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => DismissAsync(t, false)" disabled="@_busy">Back to open</button></td>
                                }
                                else
                                {
                                    <td>
                                        <select class="form-select form-select-sm" @bind="_choice[t.Id]">
                                            <option value="0">- whose payment? -</option>
                                            @foreach (var user in _users)
                                            {
                                                <option value="@user.Id">@user.Username</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-nowrap">
                                        <div class="form-check form-check-inline small" title="Book this payer's later payments to the same user by themselves. Untick when someone pays once for somebody else.">
                                            <input type="checkbox" class="form-check-input" id="remember@(t.Id)" checked="@Remember(t)" @onchange="e => _remember[t.Id] = (bool)e.Value!" />
                                            <label class="form-check-label" for="remember@(t.Id)">always</label>
                                        </div>
                                        <button class="btn btn-sm btn-primary" @onclick="() => AssignAsync(t)" disabled="@(_busy || _choice[t.Id] == 0)">Book</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => DismissAsync(t, true)" disabled="@_busy" title="Not for Snackbox, or booked by hand">Dismiss</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private PayPalStatusDto? _status;
    private List<PayPalTransactionDto>? _transactions;
    private List<UserDto> _users = new();
    private readonly Dictionary<int, int> _choice = new();
    private readonly Dictionary<int, bool> _remember = new();
    private PayPalMailboxStatusDto? _mailbox;
    private OneDriveSignInDto? _signIn;
    private string? _clientId;
    private readonly CancellationTokenSource _cts = new();
    private bool _showAll;
    private bool _busy;
    private string? _error;

    private IEnumerable<PayPalTransactionDto> Shown =>
        // Taken back by PayPal after booking: stays in sight until someone looked at it
        (_transactions ?? new()).Where(t => _showAll || (t.PaymentId == null && !t.Dismissed) || (t.ReversedAt != null && !t.Dismissed));

    protected override async Task OnInitializedAsync()
    {
        _users = (await UsersApi.GetAllAsync()).OrderBy(u => u.Username).ToList();
        await LoadAsync();
    }

    private bool Remember(PayPalTransactionDto t) => _remember.TryGetValue(t.Id, out var remember) ? remember : true;

    private async Task LoadAsync()
    {
        _mailbox = await PayPalApi.GetMailboxAsync();
        _clientId ??= _mailbox.ClientId;
        _status = await PayPalApi.GetStatusAsync();
        _transactions = await PayPalApi.GetTransactionsAsync();
        foreach (var t in _transactions)
            _choice.TryAdd(t.Id, t.AssignedUserId ?? 0);
    }

    private Task SyncAsync() => RunAsync(async () => _status = await PayPalApi.SyncAsync());

    private Task AssignAsync(PayPalTransactionDto t) =>
        RunAsync(() => PayPalApi.AssignAsync(t.Id, new AssignPayPalPayerDto { UserId = _choice[t.Id], Remember = Remember(t) }));

    private Task ConnectMailboxAsync() => RunAsync(async () =>
    {
        await PayPalApi.SetMailboxClientIdAsync(new PayPalMailboxClientIdDto { ClientId = _clientId!.Trim() });
        _signIn = await PayPalApi.StartMailboxSignInAsync();
        _ = WaitForSignInAsync(_signIn);
    });

    private async Task WaitForSignInAsync(OneDriveSignInDto signIn)
    {
        var until = DateTime.UtcNow.AddSeconds(signIn.ExpiresInSeconds);
        try
        {
            while (DateTime.UtcNow < until)
            {
                await Task.Delay(TimeSpan.FromSeconds(signIn.IntervalSeconds), _cts.Token);
                var result = (await PayPalApi.PollMailboxSignInAsync()).Result;
                if (result == "pending") continue;
                if (result != "connected") _error = $"Sign-in did not work: {result}";
                break;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _signIn = null;
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task DisconnectMailboxAsync() => RunAsync(() => PayPalApi.DisconnectMailboxAsync());

    public void Dispose() => _cts.Cancel();

    private Task DismissAsync(PayPalTransactionDto t, bool dismissed) => RunAsync(() => PayPalApi.DismissAsync(t.Id, dismissed));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _error = $"The API refused the request: {ex.StatusCode}";
            try
            {
                if (ex.Content is { Length: > 0 } content &&
                    System.Text.Json.JsonDocument.Parse(content).RootElement.TryGetProperty("message", out var message))
                    _error = message.GetString();
            }
            catch (System.Text.Json.JsonException)
            {
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
