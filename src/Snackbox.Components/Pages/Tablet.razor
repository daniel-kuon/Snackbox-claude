@page "/tablet"
@layout EmptyLayout
@implements IDisposable
@using Snackbox.Api.Dtos
@using Snackbox.ApiClient
@using Snackbox.Components.Components.History
@inject ITabletApi TabletApi
@inject IPurchasesApi PurchasesApi
@inject IPaymentsApi PaymentsApi
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject PersistentComponentState PersistentState

@* The Android tablet in the shelf (Firefox over USB, see docs/TABLET.md). The shelf has 3x3
   compartments and the tablet sits in the top middle one, so the screen is the same 3x3 grid:
   each product lies where it is shown, and the tablet's own cell holds the total and the
   buttons. A card scan of a user with the tablet feature lights it up with their purchase; users
   who pick on the tablet book products by tapping them. *@

<PageTitle>Snackbox</PageTitle>

@if (!_allowed)
{
    return;
}

<div class="tablet @(_state.Active ? "active" : "")">
    @if (_state.Active)
    {
        <div class="toolbar @Spot("toolbar")">
            <span class="who">👤 @_state.Username</span>
            <button @onclick="ShowPurchases">🧾 Purchases</button>
            <button @onclick="ShowPayments">💶 Payments</button>
            <span class="open @(_state.OpenAmount > 0 ? "owes" : "credit")">
                @(_state.OpenAmount > 0 ? "Open" : "Credit") @Math.Abs(_state.OpenAmount).ToString("0.00") €
            </span>
            @if (_state.OpenAmount > 0)
            {
                <button class="pay" @onclick="() => Open(Overlay.Pay)">Pay</button>
            }
            <button class="help @Spot("help")" @onclick="() => StartIntro(auto: false)" aria-label="Help">?</button>
        </div>
        @if (ShowReminder)
        {
            <div class="reminder">
                <PaymentReminder OpenAmount="@_state.OpenAmount" Seed="@_state.UserId" />
            </div>
        }
    }
    else
    {
        <div class="toolbar idle-bar">Snackbox · scan your card</div>
    }

    <div class="shelf @Spot("shelf") @(Unplaced.Count > 0 ? "shelf-extra" : "")">
        @for (var slot = 1; slot <= 9; slot++)
        {
            var s = slot;
            if (s == TabletSlot)
            {
                @TabletCell()
            }
            else
            {
                var products = InSlot(s);
                <div class="cell @(products.Count > DenseFrom ? "dense" : "")">
                    @foreach (var product in products)
                    {
                        @ProductRow(product)
                    }
                </div>
            }
        }

        @if (Unplaced.Count > 0)
        {
            <div class="cell extra dense">
                @foreach (var product in Unplaced)
                {
                    @ProductRow(product)
                }
            </div>
        }
    </div>
</div>

@if (_overlay == Overlay.Correction && _state.Active)
{
    <div class="overlay" @onclick="Close">
        <div class="panel" @onclick:stopPropagation="true">
            <h2>Your purchase</h2>
            @foreach (var item in _state.Items)
            {
                <div class="line">
                    <div class="line-name">@item.Name</div>
                    <div class="line-controls">
                        <button class="round" @onclick="() => Remove(item, false)" disabled="@_busy" aria-label="One less">−</button>
                        <span class="qty">@item.Quantity</span>
                        <button class="round" @onclick="() => AddById(item.ProductId)" disabled="@_busy" aria-label="One more">+</button>
                        <span class="sum">@((item.UnitPrice * item.Quantity).ToString("0.00")) €</span>
                        <button class="remove" @onclick="() => Remove(item, true)" disabled="@_busy" aria-label="Remove">✕</button>
                    </div>
                </div>
            }
            @if (_state.Items.Count == 0)
            {
                <p>Nothing picked.</p>
            }
            <button class="primary" @onclick="Close">Close</button>
        </div>
    </div>
}

@if (_overlay == Overlay.Pay && _state.Active)
{
    <div class="overlay" @onclick="Close">
        <div class="panel pay-panel" @onclick:stopPropagation="true">
            <h2>Pay @Math.Abs(_state.OpenAmount).ToString("0.00") € with PayPal</h2>
            <QRCodeComponent Url="@PayPal.PayUrl(_state.OpenAmount)" Size="420" />
            <p class="muted">Scan with your phone. Payments show up once the admin has booked them.</p>
            <button class="primary" @onclick="Close">Close</button>
        </div>
    </div>
}

<PurchasesHistoryModal IsOpen="@(_overlay == Overlay.Purchases)" OnClose="Close" Purchases="@_purchases" />
<PaymentsHistoryModal IsOpen="@(_overlay == Overlay.Payments)" OnClose="Close" Payments="@_payments" />

@if (_intro != null)
{
    var step = _intro[_introStep];
    <div class="intro-dim"></div>
    <div class="intro-caption">
        <div class="intro-count">@(_introStep + 1) / @_intro.Count</div>
        <div class="intro-text">@step.Text</div>
        <div class="intro-buttons">
            <button @onclick="EndIntro">Skip</button>
            @if (_introStep > 0)
            {
                <button @onclick="() => _introStep--">Back</button>
            }
            <button class="primary" @onclick="NextIntroStep">@(_introStep == _intro.Count - 1 ? "Let's go" : "Next")</button>
        </div>
    </div>
}

<style>
    html, body { margin: 0; background: var(--brand-anthracite, #191E1E); overflow: hidden; }
    .tablet { height: 100vh; height: 100dvh; display: flex; flex-direction: column; background: var(--brand-gradient, linear-gradient(135deg, #0082CD, #191E1E)); user-select: none; -webkit-user-select: none; }
    .toolbar { display: flex; align-items: center; gap: 8px; padding: 8px 10px; background: #fff; color: #191E1E; font-size: 1.3rem; }
    .toolbar button { border: 2px solid var(--brand-blue, #0082CD); background: #fff; color: var(--brand-blue, #0082CD); font-weight: 700; padding: 0.55rem 0.75rem; font-size: 1.2rem; }
    .toolbar .who { font-weight: 700; margin-right: auto; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .toolbar .open { font-weight: 800; padding: 0 0.3rem; white-space: nowrap; }
    .toolbar .owes { color: #c62828; }
    .toolbar .credit { color: #2e7d32; }
    .toolbar .pay { background: var(--brand-blue, #0082CD); color: #fff; }
    .toolbar .help { width: 2.9rem; border-radius: 50%; padding: 0.55rem 0; }
    .idle-bar { justify-content: center; font-weight: 700; font-size: 1.5rem; background: transparent; color: #fff; }
    .reminder { padding: 6px 6px 0; }
    .reminder .balance-notification { padding: 0.5rem 0.8rem; }
    .reminder .balance-notification .notification-icon { font-size: 2rem; }
    .reminder .balance-notification strong { font-size: 1.25rem; }
    .reminder .balance-notification p { font-size: 1.05rem; }
    .shelf { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); gap: 6px; padding: 6px; box-sizing: border-box; }
    .shelf-extra { grid-template-rows: repeat(3, 1fr) auto; }
    .cell { background: rgba(255, 255, 255, 0.14); display: flex; flex-direction: column; gap: 4px; padding: 4px; min-height: 0; min-width: 0; overflow-y: auto; }
    .extra { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; max-height: 18vh; }
    .extra .row { width: calc(33.33% - 3px); height: 90px; flex: 0 0 auto; }
    /* Bars are wide and flat: one product per row, picture over name and price. The rows share the
       compartment's height, so a compartment with few products shows them big. */
    .row { position: relative; flex: 1 1 0; min-height: 70px; background: #fff; color: #191E1E; border: 3px solid transparent; padding: 4px 6px; display: flex; flex-direction: column; gap: 2px; text-align: left; overflow: hidden; }
    .row:active { transform: scale(0.98); }
    .row.picked { border-color: var(--brand-cyan, #00BCD4); }
    .row-picture { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }
    .row-picture img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .row-placeholder { font-size: 3rem; }
    .row-text { display: flex; justify-content: space-between; align-items: baseline; gap: 4px; }
    .row-name { font-weight: 700; font-size: 1.2rem; line-height: 1.15; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .row-price { font-weight: 800; font-size: 1.3rem; color: var(--brand-blue, #0082CD); white-space: nowrap; }
    /* More than 3 in a compartment: name and price over the picture, which then gets the whole row */
    .dense .row { padding: 2px; }
    .dense .row-text { position: absolute; left: 0; right: 0; bottom: 0; padding: 2px 6px; background: rgba(25, 30, 30, 0.72); }
    .dense .row-name { color: #fff; font-size: 1.05rem; }
    .dense .row-price { color: #fff; font-size: 1.1rem; }
    .count { position: absolute; top: 4px; right: 4px; min-width: 2.2rem; height: 2.2rem; padding: 0 0.4rem; border-radius: 1.1rem; background: var(--brand-cyan, #00BCD4); color: #fff; font-weight: 800; font-size: 1.3rem; display: flex; align-items: center; justify-content: center; z-index: 1; width: max-content; left: auto; /* Firefox stretches it inside a button otherwise */ }
    .tablet-cell { background: #fff; color: #191E1E; align-items: center; justify-content: center; text-align: center; padding: 8px; gap: 4px; overflow: hidden; }
    .hello { font-size: 1.8rem; font-weight: 700; line-height: 1.1; }
    .sub { font-size: 1.2rem; opacity: 0.8; }
    .scans { font-size: 1.3rem; }
    .total { font-size: 2.5rem; font-weight: 800; color: var(--brand-blue, #0082CD); }
    .total-old { font-size: 1.1rem; font-weight: 400; opacity: 0.5; margin-right: 0.3rem; color: #191E1E; }
    .actions { display: flex; gap: 6px; width: 100%; align-items: stretch; }
    .actions button { flex: 1; padding: 0.8rem 0.2rem; font-size: 1.25rem; font-weight: 700; border: none; }
    .btn-correct { background: #fff; color: var(--brand-blue, #0082CD); border: 2px solid var(--brand-blue, #0082CD) !important; }
    .btn-done { background: var(--brand-blue, #0082CD); color: #fff; }
    .timer { flex: 0 0 auto; min-width: 3.2rem; display: flex; align-items: center; justify-content: center; border: 2px solid #191E1E; font-weight: 800; font-size: 1.25rem; }
    .hint { position: fixed; left: 50%; bottom: 12px; transform: translateX(-50%); padding: 0.6rem 1rem; background: #ffc107; color: #191E1E; font-weight: 700; z-index: 30; }
    .overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); display: flex; align-items: center; justify-content: center; z-index: 40; }
    .panel { background: #fff; color: #191E1E; width: 88vw; max-height: 88vh; overflow-y: auto; padding: 1rem 1.25rem; display: flex; flex-direction: column; }
    .panel h2 { margin: 0 0 0.5rem; font-size: 1.5rem; }
    .panel .primary { margin-top: 1rem; padding: 1rem; font-size: 1.3rem; font-weight: 700; border: none; background: var(--brand-blue, #0082CD); color: #fff; }
    .pay-panel { align-items: center; text-align: center; }
    .muted { opacity: 0.7; }
    .line { padding: 0.6rem 0; border-bottom: 1px solid #e5e5e5; }
    .line-name { font-weight: 600; font-size: 1.15rem; }
    .line-controls { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.4rem; }
    .round { width: 3rem; height: 3rem; border: 2px solid var(--brand-blue, #0082CD); background: #fff; color: var(--brand-blue, #0082CD); font-size: 1.6rem; font-weight: 700; }
    .qty { min-width: 2rem; text-align: center; font-size: 1.4rem; font-weight: 700; }
    .sum { margin-left: auto; font-weight: 700; font-size: 1.15rem; }
    .remove { width: 3rem; height: 3rem; border: none; background: #dc3545; color: #fff; font-size: 1.3rem; }
    /* Introduction: a dimming layer over everything, the highlighted part lifted above it (a
       huge box-shadow as the dimming, as on the kiosk, is not drawn by Firefox for some elements) */
    .intro-dim { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.65); z-index: 45; }
    .spot { position: relative; z-index: 50; box-shadow: 0 0 0 4px var(--brand-cyan, #00BCD4); }
    .intro-caption { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); width: 84vw; z-index: 60; background: #fff; color: #191E1E; padding: 1rem 1.2rem; box-shadow: 0 6px 30px rgba(0, 0, 0, 0.5); }
    .intro-count { font-size: 0.85rem; opacity: 0.6; }
    .intro-text { font-size: 1.25rem; font-weight: 600; margin: 0.3rem 0 0.8rem; }
    .intro-buttons { display: flex; gap: 8px; justify-content: flex-end; }
    .intro-buttons button { padding: 0.7rem 1.1rem; font-size: 1.05rem; font-weight: 700; border: 2px solid var(--brand-blue, #0082CD); background: #fff; color: var(--brand-blue, #0082CD); }
    .intro-buttons .primary { background: var(--brand-blue, #0082CD); color: #fff; }
</style>

@code {
    private static readonly TimeSpan StateInterval = TimeSpan.FromSeconds(1);
    private static readonly TimeSpan ProductsInterval = TimeSpan.FromSeconds(60);
    private static readonly TimeSpan KeepAliveInterval = TimeSpan.FromSeconds(10);

    // Compartments of the 3x3 shelf, numbered row by row; the tablet sits in the top middle one
    private const int TabletSlot = 2;

    // More products than this in a compartment: name and price go over the picture
    private const int DenseFrom = 3;

    private enum Overlay { None, Correction, Pay, Purchases, Payments }

    private record IntroStep(string Target, string Text);

    private readonly CancellationTokenSource _cts = new();
    private List<TabletProductDto> _products = new();
    private TabletStateDto _state = new();
    private DateTime _productsLoadedAt = DateTime.MinValue;
    private DateTime _lastKeepAlive = DateTime.MinValue;
    private string? _hint;
    private DateTime _hintUntil;
    private bool _busy;
    private bool _endedByDone;
    private Overlay _overlay;
    private IEnumerable<PurchaseDto>? _purchases;
    private IEnumerable<PaymentDto>? _payments;
    private List<IntroStep>? _intro;
    private int _introStep;
    private bool _introAuto;
    private int? _introShownForUser;

    private bool ShowReminder => _state.Active && _state.OpenAmount >= 10;

    private List<TabletProductDto> InSlot(int slot) => _products.Where(p => p.ShelfSlot == slot).ToList();

    // Not placed (yet): shown in a row below the shelf rather than not at all
    private List<TabletProductDto> Unplaced =>
        _products.Where(p => p.ShelfSlot is not (>= 1 and <= 9) || p.ShelfSlot == TabletSlot).ToList();

    private string Spot(string target) => _intro != null && _intro[_introStep].Target == target ? "spot" : "";

    private string FirstName => (_state.Username ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

    private RenderFragment TabletCell() => __builder =>
    {
        <div class="cell tablet-cell @Spot("total")">
            @if (!_state.Active)
            {
                <div class="hello">Snackbox</div>
                <div class="sub">Scan your card, then tap what you take</div>
            }
            else
            {
                <div class="hello">Hi @FirstName!</div>
                @if (!_state.Picking)
                {
                    <div class="scans">
                        @foreach (var scan in _state.CardScans)
                        {
                            <div>@scan.Count × @scan.Amount.ToString("0.00") €</div>
                        }
                    </div>
                }
                <div class="total">
                    @if (_state.DiscountedTotal < _state.Total)
                    {
                        <s class="total-old">@_state.Total.ToString("0.00") €</s>
                    }
                    @_state.DiscountedTotal.ToString("0.00") €
                </div>
                <div class="actions">
                    @if (_state.Picking)
                    {
                        <button class="btn-correct" @onclick="() => Open(Overlay.Correction)" disabled="@(_busy || _state.Items.Count == 0)">Correct</button>
                    }
                    <button class="btn-done @Spot("done")" @onclick="Done" disabled="@_busy">Done</button>
                    <span class="timer" title="Seconds until the purchase closes by itself">@_state.SecondsLeft</span>
                </div>
            }
        </div>
    };

    private RenderFragment ProductRow(TabletProductDto product) => __builder =>
    {
        var quantity = _state.Items.Where(i => i.ProductId == product.Id).Sum(i => i.Quantity);
        <button class="row @(quantity > 0 ? "picked" : "")" @onclick="() => Add(product)" disabled="@_busy">
            <div class="row-picture">
                @if (product.HasImage)
                {
                    <img src="tablet/image/@(product.Id)?v=@(product.ImageVersion)" alt="" loading="lazy" />
                }
                else
                {
                    <span class="row-placeholder">🍫</span>
                }
            </div>
            <div class="row-text">
                <span class="row-name">@product.Name</span>
                <span class="row-price">@product.Price.ToString("0.00") €</span>
            </div>
            @if (quantity > 0)
            {
                <span class="count">@quantity</span>
            }
        </button>
    };

    // Only for browsers on this PC (the USB tablet): decided on the HTTP request while prerendering,
    // then carried into the interactive circuit as protected state the browser cannot forge.
    // Reached by navigation inside a circuit (no request, nothing persisted) it stays empty.
    private const string AccessKey = "tablet-client-is-local";
    private bool _allowed;
    private PersistingComponentStateSubscription _persisting;

    protected override void OnInitialized()
    {
        var access = Services.GetService(typeof(TabletClientAccess)) as TabletClientAccess; // registered by the website only
        if (access?.IsLocal is { } isLocal)
        {
            _allowed = isLocal;
            _persisting = PersistentState.RegisterOnPersisting(() =>
            {
                PersistentState.PersistAsJson(AccessKey, _allowed);
                return Task.CompletedTask;
            });
        }
        else
        {
            _allowed = PersistentState.TryTakeFromJson<bool>(AccessKey, out var persisted) && persisted;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Interactive only - not during the website's prerendering
        if (firstRender && _allowed) _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(StateInterval);
        try
        {
            do
            {
                try
                {
                    var wasActive = _state.Active;
                    var previousUser = _state.UserId;
                    if (!_busy) _state = await TabletApi.GetStateAsync();

                    if (wasActive && (!_state.Active || _state.UserId != previousUser)) ResetView();

                    // No dimming while someone is choosing; between purchases Android's own timeout applies
                    if (wasActive != _state.Active) await JS.InvokeVoidAsync("snackboxKeepScreenOn", _state.Active);

                    // Ran out without Done: dark until the next scan (Done does that on the server)
                    if (wasActive && !_state.Active && !_endedByDone) await TabletApi.SleepAsync();
                    if (_state.Active) _endedByDone = false;

                    // First time on the tablet: the introduction, once per scan
                    if (_state.Active && _state.ShowIntro && _intro == null && _introShownForUser != _state.UserId)
                    {
                        _introShownForUser = _state.UserId;
                        StartIntro(auto: true);
                    }

                    // Reading counts as activity, so the purchase does not close meanwhile
                    if (_state.Active && (_intro != null || _overlay != Overlay.None) && DateTime.UtcNow - _lastKeepAlive > KeepAliveInterval)
                    {
                        _lastKeepAlive = DateTime.UtcNow;
                        await TabletApi.KeepAliveAsync();
                    }

                    // Fresh shelf after a purchase, and once a minute in case an admin changed it
                    if (DateTime.UtcNow - _productsLoadedAt > ProductsInterval || (wasActive && !_state.Active))
                    {
                        _products = await TabletApi.GetProductsAsync();
                        _productsLoadedAt = DateTime.UtcNow;
                    }

                    if (_hint != null && DateTime.UtcNow > _hintUntil) _hint = null;
                }
                catch (Exception) when (!_cts.IsCancellationRequested)
                {
                    // The API is down - BackendStatus shows it; keep trying
                }
                await InvokeAsync(StateHasChanged);
            }
            while (await timer.WaitForNextTickAsync(_cts.Token));
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ResetView()
    {
        _overlay = Overlay.None;
        _intro = null;
        _purchases = null;
        _payments = null;
    }

    private Task Add(TabletProductDto product) => AddById(product.Id);

    private async Task AddById(int productId)
    {
        if (!_state.Active)
        {
            ShowHint("Scan your card first");
            return;
        }
        if (!_state.Picking)
        {
            ShowHint("You pay with the codes on your card");
            return;
        }

        await Change(() => TabletApi.AddItemAsync(productId));
    }

    private Task Remove(TabletItemDto item, bool all) => Change(() => TabletApi.RemoveItemAsync(item.ProductId, all));

    private async Task Change(Func<Task<TabletStateDto>> call)
    {
        _busy = true;
        try
        {
            _state = await call();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            ShowHint("Your time ran out - scan your card again");
        }
        catch (Exception)
        {
            ShowHint("That did not work - please try again");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Done()
    {
        _busy = true;
        try
        {
            _endedByDone = true;
            await TabletApi.CompleteAsync();
            _state = new TabletStateDto();
            ResetView();
            _productsLoadedAt = DateTime.MinValue;
        }
        catch (Exception)
        {
            _endedByDone = false;
            ShowHint("That did not work - please try again");
        }
        finally
        {
            _busy = false;
        }
    }

    private void Open(Overlay overlay) => _overlay = overlay;

    private void Close() => _overlay = Overlay.None;

    private async Task ShowPurchases()
    {
        _overlay = Overlay.Purchases;
        _purchases = await PurchasesApi.GetByUserIdAsync(_state.UserId);
    }

    private async Task ShowPayments()
    {
        _overlay = Overlay.Payments;
        _payments = await PaymentsApi.GetByUserIdAsync(_state.UserId);
    }

    private void StartIntro(bool auto)
    {
        _overlay = Overlay.None;
        _introAuto = auto;
        _introStep = 0;
        _intro = _state.Picking
            ? [
                new("shelf", "Every compartment of the shelf is shown where it is. Tap a snack to take it - the number shows how many you have."),
                new("total", "Your total. Tapped the wrong one? \"Correct\" lets you change or remove it."),
                new("done", "Tap \"Done\" when you have everything. Otherwise the purchase closes by itself when the counter reaches 0."),
                new("toolbar", "Your purchases, your payments and what is still open. \"Pay\" shows the PayPal code."),
                new("help", "This button shows the introduction again.")
            ]
            : [
                new("total", "Every amount you scan shows up here, with your total."),
                new("done", "\"Done\" when you are finished - otherwise it closes by itself when the counter reaches 0."),
                new("toolbar", "Your purchases, your payments and what is still open. \"Pay\" shows the PayPal code."),
                new("help", "This button shows the introduction again.")
            ];
    }

    private async Task NextIntroStep()
    {
        if (_intro != null && _introStep < _intro.Count - 1) _introStep++;
        else await EndIntro();
    }

    private async Task EndIntro()
    {
        _intro = null;
        if (!_introAuto) return;

        try
        {
            await TabletApi.IntroSeenAsync();
        }
        catch (Exception)
        {
            // Shown again next time - not worth bothering the user
        }
    }

    private void ShowHint(string hint)
    {
        _hint = hint;
        _hintUntil = DateTime.UtcNow.AddSeconds(4);
    }

    // Cancelled, not disposed: the poll loop may still be reading the token
    public void Dispose()
    {
        _cts.Cancel();
        _persisting.Dispose();
    }
}
