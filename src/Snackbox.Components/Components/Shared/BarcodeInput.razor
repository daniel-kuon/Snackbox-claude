@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable

<div class="barcode-input-wrapper">
    <input type="text" 
           class="form-control @CssClass" 
           @bind="@CurrentValue" 
           @bind:event="oninput"
           placeholder="@Placeholder"
           disabled="@Disabled"
           @onkeydown="OnKeyDown"
           @ref="_inputElement" />
    @if (_scannerActive)
    {
        <span class="scanner-indicator">📷</span>
    }
</div>

@code {
    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? Placeholder { get; set; } = "Scan or enter barcode";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool DisableGlobalScanner { get; set; }

    /// <summary>
    /// A complete code: Enter in the field, or a scan while no field has focus. The field is
    /// cleared for the next scan. Use this rather than ValueChanged to act on a scan -
    /// ValueChanged fires for every single character the scanner types into the field.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnScan { get; set; }

    public ValueTask FocusAsync() => _inputElement.FocusAsync();

    private ElementReference _inputElement;
    private DotNetObjectReference<BarcodeInput>? _objRef;
    private readonly string _registrationKey = Guid.NewGuid().ToString("N");
    private bool _scannerActive;

    private string CurrentValue
    {
        get => Value;
        set
        {
            if (Value != value)
            {
                Value = value;
                ValueChanged.InvokeAsync(value);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !DisableGlobalScanner)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("barcodeScanner.register", _registrationKey, _objRef);
        }
    }

    [JSInvokable]
    public async Task OnBarcodeScanned(string barcode)
    {
        if (DisableGlobalScanner) return;

        if (OnScan.HasDelegate)
        {
            await RaiseScan(barcode);
            return;
        }

        CurrentValue = barcode;
        _scannerActive = true;
        StateHasChanged();

        await Task.Delay(1000);
        _scannerActive = false;
        StateHasChanged();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && OnScan.HasDelegate && !string.IsNullOrWhiteSpace(Value))
        {
            await RaiseScan(Value);
        }
    }

    private async Task RaiseScan(string code)
    {
        CurrentValue = string.Empty;
        await OnScan.InvokeAsync(code.Trim());
    }

    public void Dispose()
    {
        if (_objRef != null && !DisableGlobalScanner)
        {
            JS.InvokeVoidAsync("barcodeScanner.unregister", _registrationKey);
            _objRef.Dispose();
        }
    }
}

<style>
    .barcode-input-wrapper {
        position: relative;
        display: inline-block;
        width: 100%;
    }

    .scanner-indicator {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.2em;
        animation: pulse 0.5s ease-in-out;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
</style>
