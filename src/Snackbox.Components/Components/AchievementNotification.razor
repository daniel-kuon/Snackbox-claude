@using Snackbox.Components.Models
@using Snackbox.Components.Services
@implements IDisposable

<div class="achievement-overlay @(_isVisible ? "show" : "")">
    @if (_displayAchievements.Any())
    {
        <div class="achievement-container">
            <div class="achievement-header">
                <h2 class="achievement-title">
                    🎉 @(_displayAchievements.Count > 1 ? $"{_displayAchievements.Count} Achievements Unlocked!" : "Achievement Unlocked!") 🎉
                </h2>
            </div>

            <div class="achievement-cards @(_displayAchievements.Count > 1 ? "multiple" : "")">
                @foreach (var achievement in _displayAchievements)
                {
                    <div class="achievement-card">
                        <div class="achievement-content">
                            <div class="achievement-icon">
                                @if (!string.IsNullOrEmpty(achievement.ImageUrl))
                                {
                                    @((MarkupString)achievement.ImageUrl)
                                }
                                else
                                {
                                    <div class="achievement-emoji">🏆</div>
                                }
                            </div>

                            <div class="achievement-details">
                                <h3 class="achievement-name">@achievement.Name</h3>
                                <p class="achievement-description">@achievement.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(CurrentScanInfo))
            {
                <div class="current-scan-info">
                    <span class="scan-label">Current scan:</span>
                    <span class="scan-value">@CurrentScanInfo</span>
                </div>
            }
        </div>
    }
</div>

<style>
    .achievement-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .achievement-overlay.show {
        opacity: 1;
        visibility: visible;
    }

    .achievement-container {
        max-width: min(1100px, 94vw);
        max-height: 92vh;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 0.5rem;
        box-sizing: border-box;
        text-align: center;
    }

    .achievement-cards {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: stretch;
        gap: 1rem;
    }

    .achievement-card {
        background: var(--brand-gradient);
        border-radius: 20px;
        padding: 1.25rem;
        width: min(500px, 90vw);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
        animation: slideIn 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }

    .achievement-cards.multiple .achievement-card {
        width: min(340px, 90vw);
    }

    @@keyframes slideIn {
        from {
            transform: scale(0.5) translateY(-100px);
            opacity: 0;
        }
        to {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
    }

    .achievement-header {
        margin-bottom: 1.5rem;
    }

    .achievement-title {
        color: white;
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        animation: pulse 1s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
    }

    .achievement-content {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        height: 100%;
    }

    .achievement-icon {
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .achievement-icon svg {
        width: 150px;
        height: 150px;
        animation: bounce 1s ease-in-out infinite;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
    }

    .achievement-cards.multiple .achievement-icon svg {
        width: 100px;
        height: 100px;
    }

    .achievement-emoji {
        font-size: 8rem;
        animation: bounce 1s ease-in-out infinite;
    }

    .achievement-cards.multiple .achievement-emoji {
        font-size: 5rem;
    }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }

    .achievement-details {
        text-align: center;
    }

    .achievement-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #333;
        margin: 0 0 0.5rem 0;
    }

    .achievement-description {
        font-size: 1.1rem;
        color: #666;
        margin: 0;
    }

    .current-scan-info {
        margin-top: 1.25rem;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 8px;
        text-align: center;
        border-left: 4px solid var(--brand-blue);
    }

    .scan-label {
        font-weight: 600;
        color: #333;
        margin-right: 0.5rem;
    }

    .scan-value {
        font-weight: 700;
        color: var(--brand-blue);
        font-size: 1.1rem;
    }
</style>

@code {
    [Parameter]
    public List<Achievement> Achievements { get; set; } = new();

    [Parameter]
    public string CurrentScanInfo { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnAllAchievementsShown { get; set; }

    private const int BaseDisplayMs = 4000;
    private const int ExtraMsPerCard = 1500;

    private List<Achievement> _displayAchievements = new();
    private bool _isVisible;
    private bool _isDisplaying; // True during entire display cycle (including fade-out delay)
    private System.Timers.Timer? _displayTimer;
    private readonly HashSet<int> _shownAchievementIds = new();
    private bool _isDisposed;

    protected override void OnParametersSet()
    {
        // Don't start a new display cycle if we're already displaying
        if (_isDisplaying)
            return;

        // Find new achievements that haven't been shown yet
        var newAchievements = Achievements.Where(a => !_shownAchievementIds.Contains(a.Id)).ToList();
        if (!newAchievements.Any())
            return;

        // Mark the whole batch as handled - including tiers suppressed by the filter
        foreach (var achievement in newAchievements)
            _shownAchievementIds.Add(achievement.Id);

        // Of tiered achievements earned together (e.g. COMEBACK_30/60/90), show only the highest
        _displayAchievements = AchievementDisplayFilter.HighestPerFamily(newAchievements);

        _isDisplaying = true;
        _isVisible = true;

        // All achievements show at once; a bigger batch stays visible a bit longer
        var displayMs = BaseDisplayMs + ExtraMsPerCard * (_displayAchievements.Count - 1);
        _displayTimer?.Dispose();
        _displayTimer = new System.Timers.Timer(displayMs);
        _displayTimer.Elapsed += async (_, _) =>
        {
            if (_isDisposed)
                return;

            _isVisible = false;
            await InvokeAsync(StateHasChanged);

            // Let the fade-out finish before notifying the parent (which removes the component)
            await Task.Delay(500);
            if (_isDisposed)
                return;

            _isDisplaying = false;
            await InvokeAsync(async () => await OnAllAchievementsShown.InvokeAsync());
        };
        _displayTimer.AutoReset = false;
        _displayTimer.Start();
    }

    public void Dispose()
    {
        _isDisposed = true;
        _displayTimer?.Dispose();
    }
}
