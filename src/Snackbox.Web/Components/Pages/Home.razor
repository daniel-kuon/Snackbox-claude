    .th-user-name { font-size: 0.85rem; font-weight: 600; display: flex; align-items: center; gap: 0.35rem; }
    .th-tag { font-size: 0.65rem; padding: 0.05rem 0.35rem; border-radius: 4px; font-weight: 600; }
    .th-tag.inactive { background: #fff3cd; color: #856404; }
