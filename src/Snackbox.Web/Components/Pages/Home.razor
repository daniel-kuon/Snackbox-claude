        animation: setup-cta-pulse 1.8s ease-in-out infinite;
    }
    @@keyframes setup-cta-pulse {
        0%, 100% { box-shadow: 0 6px 24px rgba(13, 110, 253, 0.45); }
        50% { box-shadow: 0 6px 34px rgba(13, 110, 253, 0.85); }
    }
    .setup-cta-icon { font-size: 2.2rem; line-height: 1; }
    .setup-cta-body { flex: 1; }
    .setup-cta-body strong { font-size: 1.15rem; display: block; margin-bottom: 0.25rem; }
    .setup-cta-body p { margin: 0 0 0.75rem; opacity: 0.95; }
    .setup-cta-button {
        border: none; background: #fff; color: #0a3d8f; font-weight: 700;
