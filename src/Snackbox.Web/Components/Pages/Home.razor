</style>

@code {
    private int _remainingSeconds;
    private Timer? _countdownTimer;
    private string? _errorMessage;
    private Timer? _errorTimer;
    private bool _showPurchasesModal;
    private bool _showPaymentsModal;
    private List<PurchaseDto>? _allPurchases;
    private List<PaymentDto>? _allPayments;
    private bool _showSetupWizard;
    private bool _wizardRequiresSetup;
    private string _wizardBarcodeCode = string.Empty;
    private string? _websiteUrl;
    private string? _installUrl;
    private string? _spotlightTarget;
    private SetupWizard? _setupWizard;
    private IReadOnlyList<string> _wizardPendingSteps = Array.Empty<string>();
    private const string MobileAppFeature = "mobile_app";
    private List<TestUserDto>? _testUsers;
    private string _testFilter = string.Empty;
    private int? _loggingInUserId;
    private bool _showTestPanel;
    private bool _confirmReset;
    private bool _isResetting;
    private readonly HashSet<string> _wizardAutoShownUserIds = new();

    protected override async Task OnInitializedAsync()
    {
        // Website address shown in the intro wizard's "install on your phone" step.
        // Configurable; falls back to this PC's IP since kiosk and web server run on the same machine.
        var configured = Configuration["Website:PublicUrl"];
        _websiteUrl = string.IsNullOrWhiteSpace(configured) ? DetectLocalWebsiteUrl() : configured;
        _installUrl = BuildInstallUrl(_websiteUrl);

        // Subscribe to scanner events
        ScannerListener.CodeReceived += HandleCodeScanned;

        // Subscribe to service events
        ScannerService.OnPurchaseStarted += HandlePurchaseStarted;
        ScannerService.OnPurchaseUpdated += HandlePurchaseUpdated;
        ScannerService.OnPurchaseCompleted += HandlePurchaseCompleted;
        ScannerService.OnPurchaseTimeout += HandlePurchaseTimeout;

        // Start listening for scanner input
        ScannerListener.Start();

        // Development-only test helper - null (and hidden) unless the API enables it
        _testUsers = await TestHelper.GetUsersAsync();
    }

    private void SimulateScan(string code)
    {
        HandleCodeScanned(code);
    }

    // Own account first, then admins, then everyone else - with a text filter over
    // name, email and barcode codes.
    private List<TestUserDto> FilteredTestUsers()
    {
        if (_testUsers == null)
            return new List<TestUserDto>();

        var primary = Configuration["TestHelper:PrimaryUser"] ?? "Daniel Kuon";
        var filter = _testFilter?.Trim() ?? string.Empty;

        IEnumerable<TestUserDto> users = _testUsers;
        if (filter.Length > 0)
        {
            users = users.Where(u =>
                u.Username.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || (u.Email?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false)
                || u.Barcodes.Any(b => b.Code.Contains(filter, StringComparison.OrdinalIgnoreCase)));
        }

        return users
            .OrderByDescending(u => IsPrimaryUser(u, primary))
            .ThenByDescending(u => u.IsAdmin)
            .ThenBy(u => u.Username)
            .ToList();
    }

    private static bool IsPrimaryUser(TestUserDto user, string primary) =>
        string.Equals(user.Username, primary, StringComparison.OrdinalIgnoreCase)
        || string.Equals(user.Email, primary, StringComparison.OrdinalIgnoreCase);

    // Password-bypass login from the kiosk panel. Works for users with no barcode at all
    // (e.g. imported admins), which a simulated scan cannot do.
    private async Task LoginAsTestUser(TestUserDto user)
    {
        _loggingInUserId = user.UserId;
        try
        {
            var result = await TestHelper.LoginAsAsync(user.UserId);
            if (result.Success)
            {
                Navigation.NavigateTo(result.IsAdmin ? "/admin/dashboard" : "/home", forceLoad: true);
            }
            else
            {
                ShowError(result.ErrorMessage ?? "Test login failed");
            }
        }
        finally
        {
            _loggingInUserId = null;
            StateHasChanged();
        }
    }

    private async Task ResetDatabase()
    {
        if (!_confirmReset)
        {
            _confirmReset = true;
            return;
        }

        _isResetting = true;
        try
        {
            if (await TestHelper.ResetDatabaseAsync())
            {
                ScannerService.ResetSession();
                _testUsers = await TestHelper.GetUsersAsync();
            }
            else
            {
                ShowError("Database reset failed");
            }
        }
        finally
        {
            _confirmReset = false;
            _isResetting = false;
            StateHasChanged();
        }
    }

    private async void HandleCodeScanned(string code)
    {
        try
        {
            // Process the barcode through the service - it handles everything
            var scanResult = await ScannerService.ProcessBarcodeAsync(code);

            if (!scanResult.IsSuccess)
            {
                ShowError(scanResult.ErrorMessage ?? "Barcode not recognized");
                return;
            }

            // Login-only barcode - redirect to barcode login page
            if (scanResult.IsLoginOnly)
            {
                await InvokeAsync(() => { Navigation.NavigateTo($"/barcode-login?barcode={Uri.EscapeDataString(code)}"); });
            }
        }
        catch
        {
            ShowError("Barcode not recognized");
        }
    }

    private void HandlePurchaseStarted(PurchaseSession session)
    {
        _remainingSeconds = ScannerService.TimeoutSeconds;
        StartCountdownTimer();
        MaybeAutoOpenSetupWizard(session);
        UpdateTimerState();
        InvokeAsync(StateHasChanged);
    }

    private void HandlePurchaseUpdated(PurchaseSession session)
    {
        ResetCountdownTimer();
        UpdateTimerState();
        InvokeAsync(StateHasChanged);
    }

    // Any blocking popup (wizard, achievements, history modals) should freeze the
    // auto-complete countdown so the session doesn't time out while the user reads it.
    private bool AnyPopupOpen =>
        _showSetupWizard
        || _showPurchasesModal
        || _showPaymentsModal
        || (ScannerService.CurrentSession?.NewAchievements.Any() ?? false);

    private void UpdateTimerState()
    {
        if (AnyPopupOpen)
        {
            StopCountdownTimer();
            ScannerService.PauseTimeout();
        }
        else if (ScannerService.IsSessionActive)
        {
            ScannerService.ResumeTimeout();
            ResetCountdownTimer();
        }
    }

    private void HandlePurchaseCompleted()
    {
        StopCountdownTimer();
        InvokeAsync(StateHasChanged);
    }

    private void HandlePurchaseTimeout()
    {
        StopCountdownTimer();
        InvokeAsync(StateHasChanged);
    }

    private void StartCountdownTimer()
    {
        if (_countdownTimer is { Enabled: true })
            return;
        _countdownTimer = new Timer(1000);
        _countdownTimer.Elapsed += (_, _) =>
                                   {
                                       _remainingSeconds--;
                                       InvokeAsync(StateHasChanged);

                                       if (_remainingSeconds <= 0)
                                       {
                                           StopCountdownTimer();
                                       }
                                   };
        _countdownTimer.Start();
    }

    private void ResetCountdownTimer()
    {
        StopCountdownTimer();
        _remainingSeconds = ScannerService.TimeoutSeconds;
        StartCountdownTimer();
    }

    private void StopCountdownTimer()
    {
        if (_countdownTimer != null)
        {
            _countdownTimer.Stop();
            _countdownTimer.Dispose();
            _countdownTimer = null;
        }
    }

    private void HandleUserMouse()
    {
        // Reset UI countdown and service timeout when mouse is used
        ResetCountdownTimer();
        ScannerService.SignalActivity();
        // Mouse over the page (incl. the spotlighted element) hands the tour to the user
        _setupWizard?.NotifyUserActivity();
    }

    private async Task EnsureAllPurchasesLoadedAsync()
    {
        if (_allPurchases == null)
        {
            var list = await ScannerService.GetMyPurchasesAsync();
            _allPurchases = list.OrderByDescending(p => (p.UpdatedAt ?? p.CreatedAt)).ToList();
        }
    }

    private async Task EnsureAllPaymentsLoadedAsync()
    {
        if (_allPayments == null)
        {
            var list = await ScannerService.GetMyPaymentsAsync();
            _allPayments = list.OrderByDescending(p => p.PaidAt).ToList();
        }
    }

    private async Task OpenPurchasesModal()
    {
        await EnsureAllPurchasesLoadedAsync();
        _showPurchasesModal = true;
        UpdateTimerState();
        StateHasChanged();
    }

    private async Task OpenPaymentsModal()
    {
        await EnsureAllPaymentsLoadedAsync();
        _showPaymentsModal = true;
        UpdateTimerState();
        StateHasChanged();
    }

    private Task ClosePurchasesModal()
    {
        _showPurchasesModal = false;
        UpdateTimerState();
        return Task.CompletedTask;
    }

    private Task ClosePaymentsModal()
    {
        _showPaymentsModal = false;
        UpdateTimerState();
        return Task.CompletedTask;
    }

    private void ShowError(string message)
    {
        _errorMessage = message;
        InvokeAsync(StateHasChanged);

        // Auto-hide error after 5 seconds
        _errorTimer?.Dispose();
        _errorTimer = new Timer(5000);
        _errorTimer.Elapsed += (_, _) =>
                               {
                                   _errorMessage = null;
                                   InvokeAsync(StateHasChanged);
                                   _errorTimer?.Dispose();
                               };
        _errorTimer.AutoReset = false;
        _errorTimer.Start();
    }

    private string GetCurrentScanInfo()
    {
        if (ScannerService.CurrentSession == null)
            return string.Empty;

        var session = ScannerService.CurrentSession;
        if (session.ScannedBarcodes.Any())
        {
            var lastScan = session.ScannedBarcodes.Last();
            return $"{lastScan.Amount:C}";
        }

        return $"Total: {session.TotalAmount:C}";
    }

    // Highlights the element the current wizard step is talking about
    private string SpotlightClass(string targetKey)
        => _spotlightTarget == targetKey ? "sb-spotlight" : string.Empty;

    private bool IsFeatureEnabled(string key)
        => ScannerService.CurrentSession?.EnabledFeatures.Contains(key) ?? false;

    private void HandleHighlightChanged(string? targetKey)
    {
        _spotlightTarget = targetKey;
        StateHasChanged();
    }

    private void MaybeAutoOpenSetupWizard(PurchaseSession session)
    {
        // Auto-open once per user per app run: for setup (inactive card), or whenever the
        // API reports intro steps this user has not seen - including steps added later for
        // a feature that has since been enabled.
        if (!session.IsUserInactive && !session.PendingWizardSteps.Any())
            return;
        if (!_wizardAutoShownUserIds.Add(session.UserId))
            return;

        OpenWizard(session);
    }

    private void OpenSetupWizard()
    {
        var session = ScannerService.CurrentSession;
        if (session != null)
            OpenWizard(session);
    }

    private void OpenWizard(PurchaseSession session)
    {
        _wizardRequiresSetup = session.IsUserInactive;
        _wizardBarcodeCode = session.ScannedCardCode;
        _wizardPendingSteps = session.PendingWizardSteps.Count > 0
            ? session.PendingWizardSteps
            // Opened manually by an already-onboarded user: replay everything available
            : session.EnabledFeatures.Contains(MobileAppFeature)
                ? new List<string> { "welcome_new_version", "buying", "paying", "history", MobileAppFeature }
                : new List<string> { "welcome_new_version", "buying", "paying", "history" };
        _showSetupWizard = true;
        UpdateTimerState();
        InvokeAsync(StateHasChanged);
    }

    private Task CloseSetupWizard()
    {
        _showSetupWizard = false;
        _spotlightTarget = null;
        UpdateTimerState();
        return Task.CompletedTask;
    }

    private void HandleSetupCompleted(string newUsername)
    {
        var session = ScannerService.CurrentSession;
        if (session != null)
        {
            session.UserName = newUsername;
            session.IsUserInactive = false;
        }
        StateHasChanged();
    }

    private void HandleIntroFinished()
    {
        // The API recorded the shown steps; nothing is pending for this session anymore
        ScannerService.CurrentSession?.PendingWizardSteps.Clear();
    }

    private static string? BuildInstallUrl(string? websiteUrl)
    {
        if (string.IsNullOrWhiteSpace(websiteUrl))
            return null;
        try
        {
            // The install guide must be opened over plain HTTP - the phone can't load
            // the HTTPS site before the self-signed certificate from that page is trusted.
            // Keep any explicit port from the configured URL (dev BlazorServer runs on a
            // non-standard http port); a default port collapses to :80.
            var uri = new Uri(websiteUrl);
            var authority = uri.IsDefaultPort ? uri.Host : $"{uri.Host}:{uri.Port}";
            return $"http://{authority}/install";
        }
        catch
        {
            return null;
        }
    }

    private static string? DetectLocalWebsiteUrl()
    {
        try
        {
            var ip = Dns.GetHostAddresses(Dns.GetHostName())
                .FirstOrDefault(a => a.AddressFamily == AddressFamily.InterNetwork && !IPAddress.IsLoopback(a));
            return ip == null ? null : $"https://{ip}";
        }
        catch
        {
            return null;
        }
    }

    private void ClearAchievements()
    {
        if (ScannerService.CurrentSession != null)
        {
            ScannerService.CurrentSession.NewAchievements.Clear();
            UpdateTimerState();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        ScannerListener.CodeReceived -= HandleCodeScanned;
        ScannerService.OnPurchaseStarted -= HandlePurchaseStarted;
        ScannerService.OnPurchaseUpdated -= HandlePurchaseUpdated;
        ScannerService.OnPurchaseCompleted -= HandlePurchaseCompleted;
        ScannerService.OnPurchaseTimeout -= HandlePurchaseTimeout;

        StopCountdownTimer();
        _errorTimer?.Dispose();
    }

    private T Pick<T>(IList<T> items)
    {
        long startTimeTicks = ScannerService.CurrentSession?.StartTime.Ticks ?? 0;
        var rand = new Random((int)startTimeTicks);
        int index = rand.Next(items.Count);
        return items[index];
    }

}
