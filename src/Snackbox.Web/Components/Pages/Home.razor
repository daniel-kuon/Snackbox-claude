    /* Wizard spotlight: raises the highlighted element and dims everything else.
       The huge outer box-shadow is the dimming layer, so no separate backdrop is needed. */
    .sb-spotlight {
        position: relative;
        z-index: 1150;
        border-radius: 12px;
        box-shadow: 0 0 0 4px var(--brand-blue),
                    0 0 0 9999px rgba(0, 0, 0, 0.72);
        animation: sb-spotlight-pulse 1.6s ease-in-out infinite;
