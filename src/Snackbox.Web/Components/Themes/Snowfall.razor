@* Falling snow for the winter scenes. Each layer is one tall sheet of flakes that moves as a
   whole: three animations instead of one per flake (the kiosk PC is an old i5). The sheet moves
   by 1000px, a multiple of every tile size below, so the loop has no seam. *@
<div class="sb-snow @(Light ? "sb-snow-light" : "")" aria-hidden="true">
    <div class="sb-snow-layer s1"></div>
    <div class="sb-snow-layer s2"></div>
    <div class="sb-snow-layer s3"></div>
</div>

<style>
    .sb-snow { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .sb-snow-layer {
        position: absolute; left: 0; right: 0; top: -1000px; height: calc(100% + 1000px);
        will-change: transform; animation: sb-snowfall linear infinite;
    }
    /* Tile sizes all divide 1000px; several offset tiles per layer so the flakes do not line up */
    .sb-snow-layer.s1 {
        background:
            radial-gradient(circle, #fff 0 2.5px, transparent 3.5px) 30px 40px / 200px 200px,
            radial-gradient(circle, rgba(255, 255, 255, .85) 0 2px, transparent 3px) 140px 120px / 250px 250px,
            radial-gradient(circle, #fff 0 2.2px, transparent 3.2px) 310px 260px / 500px 500px,
            radial-gradient(circle, rgba(255, 255, 255, .9) 0 2.6px, transparent 3.6px) 77px 413px / 500px 500px,
            radial-gradient(circle, #fff 0 2px, transparent 3px) 433px 71px / 1000px 1000px,
            radial-gradient(circle, #fff 0 2.4px, transparent 3.4px) 712px 655px / 1000px 1000px;
        animation-duration: 18s; opacity: .95;
    }
    .sb-snow-layer.s2 {
        background:
            radial-gradient(circle, rgba(255, 255, 255, .8) 0 1.6px, transparent 2.4px) 80px 10px / 125px 125px,
            radial-gradient(circle, rgba(255, 255, 255, .7) 0 1.4px, transparent 2.2px) 13px 67px / 200px 200px,
            radial-gradient(circle, rgba(255, 255, 255, .75) 0 1.5px, transparent 2.3px) 171px 233px / 250px 250px,
            radial-gradient(circle, rgba(255, 255, 255, .7) 0 1.3px, transparent 2.1px) 389px 151px / 500px 500px;
        animation-duration: 28s; opacity: .8;
    }
    .sb-snow-layer.s3 {
        background:
            radial-gradient(circle, rgba(255, 255, 255, .9) 0 4px, transparent 5.5px) 60px 90px / 500px 500px,
            radial-gradient(circle, rgba(255, 255, 255, .85) 0 3.5px, transparent 5px) 610px 470px / 1000px 1000px,
            radial-gradient(circle, rgba(255, 255, 255, .9) 0 4.5px, transparent 6px) 290px 820px / 1000px 1000px;
        animation-duration: 12s; opacity: .7;
    }
    .sb-snow-light .sb-snow-layer.s2 { display: none; }
    .sb-snow-light .sb-snow-layer { opacity: .55; }
    @@keyframes sb-snowfall { to { transform: translateY(1000px); } }
</style>

@code {
    /// <summary>Fewer, fainter flakes - behind the purchase panels.</summary>
    [Parameter] public bool Light { get; set; }
}
