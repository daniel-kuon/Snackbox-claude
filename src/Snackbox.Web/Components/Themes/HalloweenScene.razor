@* Halloween on the kiosk: a moonlit night with a haunted house, graves, glowing pumpkins, bats,
   ghosts, a spider and the odd lightning on the welcome screen; on a purchase the same night
   around the panels, a pumpkin countdown and a ghost that says BOO at every scan. Only
   transform/opacity are animated - cheap enough for the kiosk PC. *@
<div class="hw-scene @(Welcome ? "hw-welcome" : "hw-purchase") @(Quiet ? "hw-quiet" : "")" aria-hidden="true">
    <div class="hw-back">
        <div class="hw-sky"></div>
        @foreach (var s in Stars)
        {
            <span class="hw-star" style="@s"></span>
        }
        <div class="hw-moon"><span class="hw-crater c1"></span><span class="hw-crater c2"></span><span class="hw-crater c3"></span></div>

        @if (Welcome)
        {
            <svg class="hw-witch" viewBox="0 -20 160 100"><use href="#hw-witch-shape" /></svg>

            <svg class="hw-land" viewBox="0 0 1000 420">
                <path d="M0 300 Q120 230 260 270 T520 250 T780 240 T1000 260 L1000 420 L0 420 Z" fill="#1d0f30" />
                <path d="M380 420 L380 330 Q560 230 760 250 Q880 262 1000 230 L1000 420 Z" fill="#0d0716" />
                @* haunted house *@
                <g fill="#0a0510">
                    <rect x="670" y="104" width="16" height="40" />
                    <rect x="650" y="150" width="150" height="112" />
                    <polygon points="636,156 725,90 814,156" />
                    <rect x="790" y="110" width="48" height="152" />
                    <polygon points="780,112 814,36 848,112" />
                    <line x1="814" y1="36" x2="814" y2="20" stroke="#0a0510" stroke-width="3" />
                </g>
                <g class="hw-windows">
                    <rect class="hw-win w1" x="668" y="172" width="24" height="30" />
                    <rect class="hw-win w2" x="711" y="172" width="24" height="30" />
                    <rect class="hw-win w3" x="754" y="172" width="24" height="30" />
                    <path class="hw-win w4" d="M803 158 L803 140 Q814 126 825 140 L825 158 Z" />
                    <rect class="hw-win w5" x="713" y="217" width="24" height="45" />
                </g>
                @* dead tree *@
                <g stroke="#0d0716" stroke-linecap="round" fill="none">
                    <path d="M470 335 C468 290 476 262 466 214" stroke-width="12" />
                    <path d="M468 262 C442 244 430 226 408 214" stroke-width="6" />
                    <path d="M470 244 C500 222 512 204 534 196" stroke-width="6" />
                    <path d="M467 226 C458 202 470 186 460 168" stroke-width="5" />
                    <path d="M436 232 C428 224 418 228 408 222" stroke-width="3" />
                    <path d="M512 206 C520 190 530 188 540 180" stroke-width="3" />
                </g>
                @* graveyard *@
                <path d="M0 420 L0 356 Q200 326 420 348 Q520 358 610 420 Z" fill="#120a1c" />
                <g fill="#3a3346" stroke="#241e2e" stroke-width="3">
                    <path d="M96 392 L96 334 Q96 312 120 312 Q144 312 144 334 L144 392 Z" />
                    <path d="M190 386 L190 344 Q190 326 208 326 Q226 326 226 344 L226 386 Z" transform="rotate(-6 208 360)" />
                    <path d="M280 388 L280 338 Q280 316 304 316 Q328 316 328 338 L328 388 Z" transform="rotate(4 304 350)" />
                    <path d="M372 380 L380 330 L396 330 L404 380 Z" />
                    <rect x="356" y="342" width="64" height="12" />
                </g>
                <g fill="#5d566b" font-family="Georgia, serif" font-weight="bold" text-anchor="middle">
                    <text x="120" y="352" font-size="16">RIP</text>
                    <text x="208" y="362" font-size="12" transform="rotate(-6 208 360)">BOO</text>
                    <text x="304" y="356" font-size="14" transform="rotate(4 304 350)">RIP</text>
                </g>
            </svg>

            <div class="hw-pumpkin p1"><svg viewBox="0 0 120 110"><use href="#hw-pumpkin-shape" /></svg></div>
            <div class="hw-pumpkin p2"><svg viewBox="0 0 120 110"><use href="#hw-pumpkin-shape" /></svg></div>
            <div class="hw-pumpkin p3"><svg viewBox="0 0 120 110"><use href="#hw-pumpkin-shape" /></svg></div>
        }

        <div class="hw-fog f1"></div>
        <div class="hw-fog f2"></div>
        @if (Welcome)
        {
            <div class="hw-flash"></div>
        }
    </div>

    <div class="hw-front">
        @foreach (var b in Welcome ? WelcomeBats : PurchaseBats)
        {
            <div class="hw-bat" style="@b"><svg viewBox="0 0 120 60"><use href="#hw-bat-shape" /></svg></div>
        }

        @if (Welcome)
        {
            <div class="hw-ghost g1"><svg viewBox="0 0 100 120"><use href="#hw-ghost-shape" /></svg></div>
            <div class="hw-ghost g2"><svg viewBox="0 0 100 120"><use href="#hw-ghost-shape" /></svg></div>
            <div class="hw-ghost g3"><svg viewBox="0 0 100 120"><use href="#hw-ghost-shape" /></svg></div>
        }
        else
        {
            <div class="hw-peek"><svg viewBox="0 0 100 120"><use href="#hw-ghost-shape" /></svg></div>
        }

        <svg class="hw-web left" viewBox="0 0 200 200"><path d="@WebPath" /></svg>
        <svg class="hw-web right" viewBox="0 0 200 200"><path d="@WebPath" /></svg>

        <div class="hw-spider-anchor">
            <div class="hw-spider">
                <div class="hw-thread"></div>
                <svg viewBox="0 0 60 60"><use href="#hw-spider-shape" /></svg>
            </div>
        </div>

        @if (!Welcome && ScanCount > 0)
        {
            <div class="hw-boo" @key="ScanCount">
                <svg viewBox="0 0 100 120"><use href="#hw-ghost-shape" /></svg>
                <span>BOO!</span>
            </div>
        }
    </div>

    @* Shapes, drawn once and reused *@
    <svg width="0" height="0" style="position:absolute">
        <defs>
            <g id="hw-bat-shape">
                <path fill="#0b0710" d="M60 22 C56 14 50 10 44 12 C40 4 30 2 20 8 C16 14 10 16 2 14 C10 26 20 32 32 32 C38 32 42 36 46 42 C50 38 54 38 60 46 C66 38 70 38 74 42 C78 36 82 32 88 32 C100 32 110 26 118 14 C110 16 104 14 100 8 C90 2 80 4 76 12 C70 10 64 14 60 22 Z" />
                <ellipse cx="60" cy="27" rx="7" ry="11" fill="#0b0710" />
                <path fill="#0b0710" d="M54 19 L52 8 L58 16 Z M66 19 L68 8 L62 16 Z" />
                <circle cx="57" cy="23" r="1.4" fill="#ff3b1f" />
                <circle cx="63" cy="23" r="1.4" fill="#ff3b1f" />
            </g>
            <g id="hw-ghost-shape">
                <path fill="rgba(245,245,255,.92)" d="M50 5 C24 5 10 26 10 52 L10 112 L22 100 L34 112 L46 100 L58 112 L70 100 L82 112 L90 102 L90 52 C90 26 76 5 50 5 Z" />
                <ellipse cx="37" cy="48" rx="7" ry="10" fill="#1a1024" />
                <ellipse cx="63" cy="48" rx="7" ry="10" fill="#1a1024" />
                <ellipse cx="50" cy="74" rx="8" ry="11" fill="#1a1024" />
                <ellipse cx="28" cy="62" rx="5" ry="3" fill="rgba(255,140,170,.45)" />
                <ellipse cx="72" cy="62" rx="5" ry="3" fill="rgba(255,140,170,.45)" />
            </g>
            <g id="hw-pumpkin-shape">
                <path d="M58 20 C58 10 64 4 72 4 C68 9 66 14 66 21 Z" fill="#3d6b1f" />
                <ellipse cx="36" cy="64" rx="30" ry="40" fill="#d9600a" />
                <ellipse cx="84" cy="64" rx="30" ry="40" fill="#d9600a" />
                <ellipse cx="60" cy="64" rx="31" ry="44" fill="#f7821b" />
                <g class="hw-face" fill="#ffd34d">
                    <polygon points="36,52 50,52 43,38" />
                    <polygon points="70,52 84,52 77,38" />
                    <polygon points="55,66 65,66 60,58" />
                    <path d="M32 76 Q60 100 88 76 L80 80 L76 74 L70 82 L64 76 L58 84 L52 76 L46 82 L40 74 Z" />
                </g>
            </g>
            <g id="hw-spider-shape" stroke="#0b0710" stroke-width="2.5" stroke-linecap="round" fill="none">
                <path d="M30 34 L12 22 L4 30 M30 36 L10 36 L2 46 M30 38 L12 48 L8 58 M30 34 L48 22 L56 30 M30 36 L50 36 L58 46 M30 38 L48 48 L52 58" />
                <circle cx="30" cy="38" r="10" fill="#0b0710" stroke="none" />
                <circle cx="30" cy="24" r="7" fill="#0b0710" stroke="none" />
                <circle cx="27" cy="23" r="1.6" fill="#ff3b1f" stroke="none" />
                <circle cx="33" cy="23" r="1.6" fill="#ff3b1f" stroke="none" />
            </g>
            <g id="hw-witch-shape" fill="#0a0510">
                <line x1="8" y1="54" x2="128" y2="40" stroke="#0a0510" stroke-width="4" />
                <polygon points="124,38 158,28 158,54 128,46" />
                <polygon points="58,50 78,20 100,46 92,52 70,54" />
                <circle cx="78" cy="16" r="7" />
                <polygon points="66,12 92,10 88,-16" />
                <polygon points="60,12 98,9 98,13 60,16" />
                <line x1="84" y1="50" x2="70" y2="62" stroke="#0a0510" stroke-width="4" />
                <path d="M74 30 C60 30 46 40 36 36 C44 44 60 44 72 40 Z" />
            </g>
        </defs>
    </svg>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Creepster&display=swap');

    /* ---------- the screen it decorates (Home puts sb-theme-halloween on its container) ---------- */
    .sb-theme-halloween .scan-prompt-container,
    .sb-theme-halloween .scanner-active { position: relative; z-index: 1; background: transparent; }
    .sb-theme-halloween .scanner-active { padding: 0.9rem; }

    .sb-theme-halloween .scan-title {
        font-family: 'Creepster', 'Chiller', 'Jokerman', fantasy; font-weight: 400; letter-spacing: .03em;
        color: #ff7518;
        text-shadow: 0 0 .08em #ff4d00, 0 0 .45em rgba(255, 90, 0, .65), 0 .05em 0 #4a1500;
        animation: hw-title 3.2s ease-in-out infinite;
    }
    .sb-theme-halloween .scan-instruction {
        color: #b6f35a; text-shadow: 0 0 .1em #6fd400, 0 0 .6em rgba(120, 220, 0, .45);
        animation: hw-sway 4s ease-in-out infinite;
    }
    @@keyframes hw-title { 50% { text-shadow: 0 0 .12em #ff6a00, 0 0 .9em rgba(255, 110, 0, .9), 0 .05em 0 #4a1500; } }
    @@keyframes hw-sway { 50% { transform: translateX(.4rem) rotate(-.6deg); } }

    .sb-theme-halloween .purchase-section,
    .sb-theme-halloween .qr-section {
        background: #fffaf2;
        box-shadow: 0 0 0 2px rgba(255, 117, 24, .65), 0 0 26px rgba(255, 117, 24, .45), 0 10px 34px rgba(0, 0, 0, .55);
    }
    .sb-theme-halloween .section-title,
    .sb-theme-halloween .user-name {
        font-family: 'Creepster', 'Chiller', fantasy; font-weight: 400; letter-spacing: .05em; color: #d9600a;
    }
    .sb-theme-halloween .total-amount { color: #d9600a; text-shadow: 0 0 12px rgba(255, 117, 24, .45); }

    /* The countdown as a jack-o'-lantern */
    .sb-theme-halloween .timer-circle {
        position: relative; border-radius: 46% 46% 50% 50% / 52% 52% 48% 48%;
        background: radial-gradient(circle at 50% 42%, #ffb347 0%, #f7821b 45%, #c75208 100%);
        box-shadow: 0 0 22px rgba(255, 120, 0, .75), inset 0 -6px 10px rgba(120, 40, 0, .45);
        animation: hw-pumpkin-glow 1.6s ease-in-out infinite;
    }
    .sb-theme-halloween .timer-circle::before {
        content: ""; position: absolute; top: -9px; left: 50%; width: 9px; height: 14px; margin-left: -4px;
        background: #3d6b1f; border-radius: 3px 6px 2px 2px; transform: rotate(12deg);
    }
    .sb-theme-halloween .timer-text { color: #2b0f00; text-shadow: 0 0 6px #ffd34d; }
    @@keyframes hw-pumpkin-glow { 50% { box-shadow: 0 0 34px rgba(255, 150, 0, .95), inset 0 -6px 10px rgba(120, 40, 0, .45); } }

    /* Achievements in the colours of the night */
    .sb-theme-halloween .ach-slam-overlay { background: radial-gradient(ellipse at 50% 30%, #4a1d6e 0%, #1a0b2e 55%, #07030d 100%); }
    .sb-theme-halloween .ach-slam-card,
    .sb-theme-halloween .ach-slam-mini-box { border-top-color: #ff7518; }
    .sb-theme-halloween .ach-slam-count { color: #ff7518; }
    .sb-theme-halloween .ach-slam-ring { border-color: #ff7518; }

    /* ---------- the scene ---------- */
    .hw-scene, .hw-back, .hw-front { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .hw-back { z-index: 0; }
    .hw-front { z-index: 40; transition: opacity .4s; }
    .hw-quiet .hw-front { opacity: 0; }

    .hw-sky { position: absolute; inset: 0; background: radial-gradient(ellipse at 78% 14%, #4a2370 0%, #23103a 32%, #0d0617 72%, #050208 100%); }
    .hw-purchase .hw-sky { background: radial-gradient(ellipse at 50% 0%, #3a1b58 0%, #170a26 50%, #050208 100%); }

    .hw-star { position: absolute; border-radius: 50%; background: #fff; opacity: .2; animation: hw-twinkle 3s ease-in-out infinite; }
    @@keyframes hw-twinkle { 50% { opacity: .95; transform: scale(1.4); } }

    .hw-moon {
        position: absolute; top: 7vh; right: 9vw; width: 22vmin; height: 22vmin; border-radius: 50%;
        background: radial-gradient(circle at 38% 36%, #fffbe6 0%, #f6e7a8 55%, #d9c37a 100%);
        box-shadow: 0 0 6vmin rgba(255, 240, 180, .55), 0 0 18vmin rgba(255, 220, 140, .25);
        animation: hw-moon 9s ease-in-out infinite;
    }
    .hw-purchase .hw-moon { top: -11vmin; right: 46vw; width: 18vmin; height: 18vmin; opacity: .8; }
    .hw-crater { position: absolute; border-radius: 50%; background: rgba(180, 160, 100, .35); }
    .hw-crater.c1 { width: 22%; height: 22%; left: 22%; top: 30%; }
    .hw-crater.c2 { width: 14%; height: 14%; left: 58%; top: 52%; }
    .hw-crater.c3 { width: 10%; height: 10%; left: 40%; top: 68%; }
    @@keyframes hw-moon { 50% { box-shadow: 0 0 8vmin rgba(255, 240, 180, .7), 0 0 24vmin rgba(255, 220, 140, .32); } }

    .hw-witch { position: absolute; top: 9vh; width: 16vmin; left: 0; animation: hw-witch 30s linear infinite; animation-delay: 4s; opacity: 0; }
    @@keyframes hw-witch {
        0% { transform: translate(100vw, 6vh) rotate(-4deg); opacity: 1; }
        20% { transform: translate(70vw, 3vh) rotate(3deg); opacity: 1; }
        40% { transform: translate(-20vw, 10vh) rotate(-3deg); opacity: 1; }
        41%, 100% { transform: translate(-20vw, 10vh); opacity: 0; }
    }

    /* Full width, height from the drawing: cropping its top cut the roof and the tower off on wide screens */
    .hw-land { position: absolute; left: 0; bottom: 0; width: 100%; height: auto; display: block; }
    .hw-win { fill: #ffbf3f; animation: hw-window 5s steps(1) infinite; }
    .hw-win.w2 { animation-delay: -1.3s; animation-duration: 7s; }
    .hw-win.w3 { animation-delay: -2.7s; animation-duration: 4s; }
    .hw-win.w4 { animation-delay: -.6s; animation-duration: 6s; fill: #9cff5a; }
    .hw-win.w5 { fill: #ff9a2e; opacity: .7; animation: none; }
    @@keyframes hw-window { 0% { opacity: 1; } 42% { opacity: .35; } 46% { opacity: 1; } 71% { opacity: .15; } 74% { opacity: .9; } }

    .hw-pumpkin { position: absolute; filter: drop-shadow(0 0 1.6vmin rgba(255, 140, 0, .75)); }
    .hw-pumpkin svg { width: 100%; display: block; }
    .hw-pumpkin.p1 { left: 3vw; bottom: 2vh; width: 15vmin; }
    .hw-pumpkin.p2 { left: 15vw; bottom: 1vh; width: 10vmin; animation: hw-hop 6s ease-in-out infinite; }
    .hw-pumpkin.p3 { left: 44vw; bottom: 3vh; width: 8vmin; }
    .hw-face { animation: hw-flicker 1.7s infinite; }
    .hw-pumpkin.p2 .hw-face { animation-duration: 1.1s; }
    .hw-pumpkin.p3 .hw-face { animation-duration: 2.3s; }
    @@keyframes hw-flicker { 0%, 100% { opacity: 1; } 18% { opacity: .55; } 22% { opacity: .95; } 47% { opacity: .7; } 53% { opacity: 1; } 78% { opacity: .5; } }
    @@keyframes hw-hop { 0%, 80%, 100% { transform: translateY(0); } 86% { transform: translateY(-3vmin) rotate(-6deg); } 92% { transform: translateY(0) rotate(4deg); } }

    .hw-fog {
        position: absolute; left: -50%; bottom: -6vh; width: 200%; height: 30vh;
        background:
            radial-gradient(ellipse 22% 60% at 15% 60%, rgba(210, 200, 240, .20), transparent 70%),
            radial-gradient(ellipse 25% 55% at 45% 70%, rgba(210, 200, 240, .16), transparent 70%),
            radial-gradient(ellipse 20% 60% at 75% 62%, rgba(210, 200, 240, .18), transparent 70%);
        animation: hw-fog 46s linear infinite alternate;
    }
    .hw-fog.f2 { bottom: -12vh; opacity: .8; animation-duration: 31s; animation-direction: alternate-reverse; }
    .hw-purchase .hw-fog { opacity: .7; }
    @@keyframes hw-fog { to { transform: translateX(25%); } }

    .hw-flash { position: absolute; inset: 0; background: #dfe8ff; opacity: 0; animation: hw-lightning 19s infinite; }
    @@keyframes hw-lightning { 0%, 88%, 100% { opacity: 0; } 89% { opacity: .5; } 90% { opacity: .05; } 91.5% { opacity: .38; } 93% { opacity: 0; } }

    .hw-bat { position: absolute; left: 0; top: 0; width: var(--size); opacity: .95; animation: hw-fly var(--dur) linear infinite; animation-delay: var(--delay); }
    .hw-bat svg { width: 100%; display: block; animation: hw-flap .22s ease-in-out infinite alternate; transform-origin: 50% 45%; }
    @@keyframes hw-flap { to { transform: scaleY(.3) translateY(4%); } }
    @@keyframes hw-fly {
        0% { transform: translate(var(--x0), var(--y0)); }
        25% { transform: translate(var(--x1), var(--y1)); }
        50% { transform: translate(var(--x2), var(--y2)); }
        75% { transform: translate(var(--x3), var(--y3)); }
        100% { transform: translate(var(--x4), var(--y4)); }
    }

    .hw-ghost { position: absolute; width: 12vmin; opacity: .85; filter: drop-shadow(0 0 2vmin rgba(220, 220, 255, .55)); }
    .hw-ghost svg { width: 100%; display: block; }
    .hw-ghost.g1 { left: 26vw; bottom: 30vh; animation: hw-bob 4.5s ease-in-out infinite; }
    .hw-ghost.g2 { right: 30vw; bottom: 46vh; width: 7vmin; opacity: .55; animation: hw-bob 6s ease-in-out infinite reverse; }
    .hw-ghost.g3 { left: 0; top: 34vh; width: 9vmin; opacity: .7; animation: hw-drift 38s linear infinite; }
    @@keyframes hw-bob { 50% { transform: translate(1.5vmin, -3vmin) rotate(4deg); } }
    @@keyframes hw-drift {
        0% { transform: translate(-15vw, 0) scaleX(-1); }
        25% { transform: translate(25vw, -6vh) scaleX(-1); }
        50% { transform: translate(55vw, 4vh) scaleX(-1); }
        62% { transform: translate(62vw, -2vh) scale(2.2); opacity: .9; }
        70% { transform: translate(68vw, 2vh) scaleX(-1); opacity: .7; }
        100% { transform: translate(115vw, -4vh) scaleX(-1); }
    }

    .hw-peek { position: absolute; left: 1.5vw; bottom: 0; width: 9vmin; transform: translateY(110%); animation: hw-peek 24s ease-in-out infinite; animation-delay: 6s; filter: drop-shadow(0 0 1.5vmin rgba(220, 220, 255, .6)); }
    .hw-peek svg { width: 100%; display: block; }
    @@keyframes hw-peek {
        0%, 70%, 100% { transform: translateY(110%) rotate(0); }
        76%, 88% { transform: translateY(35%) rotate(-8deg); }
        82% { transform: translateY(30%) rotate(8deg); }
    }

    .hw-web { position: absolute; top: 0; width: 18vmin; height: 18vmin; opacity: .5; }
    .hw-web path { fill: none; stroke: #e8e4f0; stroke-width: 1.1; }
    .hw-web.left { left: 0; }
    .hw-web.right { right: 0; transform: scaleX(-1); }
    .hw-purchase .hw-web { width: 12vmin; height: 12vmin; opacity: .4; }

    .hw-spider-anchor { position: absolute; top: 0; left: 58vw; }
    .hw-purchase .hw-spider-anchor { left: 50%; }
    .hw-spider { position: relative; width: 5vmin; margin-left: -2.5vmin; animation: hw-dangle 7s ease-in-out infinite; }
    .hw-spider svg { width: 100%; display: block; }
    .hw-thread { position: absolute; left: 50%; bottom: 70%; width: 1px; height: 100vh; background: rgba(235, 235, 245, .55); }
    @@keyframes hw-dangle {
        0%, 100% { transform: translateY(6vh); }
        30% { transform: translateY(24vh) rotate(6deg); }
        45% { transform: translateY(20vh) rotate(-5deg); }
        60% { transform: translateY(26vh); }
        80% { transform: translateY(4vh); }
    }
    .hw-purchase .hw-spider { animation-name: hw-dangle-short; }
    @@keyframes hw-dangle-short { 0%, 100% { transform: translateY(-2vh); } 40% { transform: translateY(9vh) rotate(5deg); } 60% { transform: translateY(7vh) rotate(-4deg); } }

    .hw-boo { position: absolute; left: 22vw; top: 34vh; width: 16vmin; text-align: center; animation: hw-boo 1.6s ease-out forwards; }
    .hw-boo svg { width: 100%; display: block; filter: drop-shadow(0 0 2vmin rgba(220, 220, 255, .8)); }
    .hw-boo span {
        display: block; font-family: 'Creepster', 'Chiller', fantasy; font-size: 6vmin; color: #ff7518;
        text-shadow: 0 0 10px #ff4d00, 0 2px 0 #4a1500;
    }
    @@keyframes hw-boo {
        0% { transform: scale(.2) translateY(20vh); opacity: 0; }
        25% { transform: scale(1.25) translateY(0); opacity: 1; }
        40% { transform: scale(1) rotate(-6deg); }
        55% { transform: scale(1.05) rotate(5deg); opacity: 1; }
        100% { transform: scale(.9) translateY(-18vh); opacity: 0; }
    }
</style>

@code {
    [Parameter] public bool Welcome { get; set; }
    [Parameter] public int ScanCount { get; set; }
    [Parameter] public bool Quiet { get; set; }

    // Styles are written with the invariant culture: the kiosk runs in German, where 12.5 is "12,5"

    // Fixed seed: the same sky on every render
    private static readonly string[] Stars = MakeStars();

    private static string[] MakeStars()
    {
        var random = new Random(31);
        return Enumerable.Range(0, 70)
            .Select(_ =>
            {
                var size = random.Next(1, 4);
                return FormattableString.Invariant(
                    $"left:{random.NextDouble() * 100:0.0}%;top:{random.NextDouble() * 62:0.0}%;width:{size}px;height:{size}px;animation-delay:{random.NextDouble() * 4:0.0}s;animation-duration:{2 + random.NextDouble() * 3:0.0}s");
            })
            .ToArray();
    }

    // Each bat: size, duration, delay and five waypoints - left to right or back, mostly up top
    private static readonly string[] WelcomeBats =
    [
