    private static string Bat(string size, double dur, double delay, params double[] xy) =>
        FormattableString.Invariant($"--size:{size};--dur:{dur}s;--delay:{delay}s;") +
        string.Concat(Enumerable.Range(0, 5).Select(i => FormattableString.Invariant($"--x{i}:{xy[i * 2]}vw;--y{i}:{xy[i * 2 + 1]}vh;")));

    // A cobweb in the top-left corner: spokes and sagging rings
    private static readonly string WebPath = MakeWeb();

    private static string MakeWeb()
    {
        const int spokes = 6;
        var angles = Enumerable.Range(0, spokes).Select(i => Math.PI / 2 * i / (spokes - 1)).ToArray();
        string P(double r, double a) => FormattableString.Invariant($"{r * Math.Cos(a):0.0} {r * Math.Sin(a):0.0}");

        var sb = new System.Text.StringBuilder();
        foreach (var a in angles) sb.Append($"M0 0 L{P(200, a)} ");
        foreach (var r in new[] { 36.0, 70, 106, 144, 184 })
        {
            sb.Append($"M{P(r, angles[0])} ");
            for (var i = 1; i < spokes; i++)
            {
                var mid = (angles[i - 1] + angles[i]) / 2;
                sb.Append($"Q{P(r * 0.82, mid)} {P(r, angles[i])} ");
            }
        }
        return sb.ToString().Trim();
    }
