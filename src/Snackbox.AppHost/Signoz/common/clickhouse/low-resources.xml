<!-- The kiosk PC is a 4-core i5 with 8 GB that also runs the apps. ClickHouse's defaults are
     made for a database server: on that PC it took 110 % CPU and 1 GB and had written 200 GB,
     mostly its own monitoring tables, not SigNoz's data. -->
<clickhouse>
    <!-- ClickHouse's own logging tables: queries, merges, metrics every second, profiler
         samples. SigNoz does not read them. The ones enabled by default without being
         configured (error_log, latency_log, query_metric_log) need the same remove. -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <processors_profile_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <query_metric_log remove="1"/>

    <!-- Server metrics are recomputed every second by default -->
    <asynchronous_metrics_update_period_s>60</asynchronous_metrics_update_period_s>

    <!-- Fewer background threads for merges and housekeeping: the data arrives in a trickle -->
    <background_pool_size>4</background_pool_size>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_common_pool_size>4</background_common_pool_size>
    <background_move_pool_size>2</background_move_pool_size>
    <background_fetches_pool_size>2</background_fetches_pool_size>
    <background_buffer_flush_schedule_pool_size>2</background_buffer_flush_schedule_pool_size>
    <background_distributed_schedule_pool_size>4</background_distributed_schedule_pool_size>
    <background_message_broker_schedule_pool_size>2</background_message_broker_schedule_pool_size>
    <!-- These must stay below background_pool_size * 2 (the merge concurrency ratio) or the
         server refuses to start -->
    <merge_tree>
        <number_of_free_entries_in_pool_to_execute_mutation>4</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>4</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>4</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>

    <!-- Caches sized for gigabytes of RAM to spare -->
    <mark_cache_size>268435456</mark_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>
</clickhouse>
