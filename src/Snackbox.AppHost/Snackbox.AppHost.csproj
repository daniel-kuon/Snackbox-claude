<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <!-- Installations run the AppHost with plain "dotnet run" and have no Aspire CLI, so the
         orchestrator has to come from the NuGet packages, not from a separately installed CLI
         bundle (whose version would drift from these packages). -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.0" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.0" />
    <PackageReference Include="Nextended.Aspire" Version="10.1.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snackbox.Api\Snackbox.Api.csproj" />
    <ProjectReference Include="..\Snackbox.BlazorServer\Snackbox.BlazorServer.csproj" />
  </ItemGroup>

</Project>
